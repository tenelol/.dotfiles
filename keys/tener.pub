# SSH public key for tener on managed NixOS hosts
#
# 手順:
#   1. 使用する SSH 鍵の公開鍵を確認する
#      $ cat ~/.ssh/id_ed25519.pub
#
#   2. 上の出力をこのコメントの下に貼り付ける
#      例: ssh-ed25519 AAAA... tener@machine
#
#   3. shared/nixos の serverSecurity module で password login を無効化する
#
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFFkbcnmTY5/V7n2pf6Huiqdn8DPaR8qs0tHajYXQaIs
