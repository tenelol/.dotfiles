#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

usage() {
  cat <<'EOF'
Usage: ./scripts/validate <eval|linux|darwin>

  eval    Evaluate every nixos/darwin configuration without building
  linux   Run lightweight evaluation, then build all Linux hosts with nh
  darwin  Run lightweight evaluation, then build the macOS host with nh
EOF
}

list_configurations() {
  local config_attr="$1"

  nix eval --raw ".#${config_attr}" --apply 'configs: builtins.concatStringsSep "\n" (builtins.attrNames configs)'
}

eval_configuration() {
  local config_attr="$1"
  local config_name="$2"
  local drv_path

  drv_path="$(nix eval --raw ".#${config_attr}.${config_name}.config.system.build.toplevel.drvPath")"
  printf '%s: %s\n' "$config_name" "$drv_path"
}

eval_configurations() {
  local config_attr="$1"
  local config_name

  while IFS= read -r config_name; do
    [ -n "$config_name" ] || continue
    eval_configuration "$config_attr" "$config_name"
  done < <(list_configurations "$config_attr")
}

mode="${1:-linux}"

case "$mode" in
  eval|linux|darwin)
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

eval_configurations "nixosConfigurations"
eval_configurations "darwinConfigurations"

case "$mode" in
  eval)
    ;;
  linux)
    nh os build . -H nixos
    nh os build . -H nvidia-desktop
    nh os build . -H nixos-server
    ;;
  darwin)
    nh darwin build . -H macbook
    ;;
esac
