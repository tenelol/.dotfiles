#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

usage() {
  cat <<'EOF'
Usage: ./scripts/validate <structure|eval|linux|darwin>

  structure
          Check active Nix files for bloat-prone oversized modules
  eval    Run flake checks without building outputs
  linux   Run no-build flake checks, then build all Linux hosts with nh
  darwin  Run no-build flake checks, then build the macOS host with nh
EOF
}

run_structure_check() {
  local max_nix_lines=500
  local failed=0
  local file
  local lines

  while IFS= read -r file; do
    case "$file" in
      hosts/*/hardware-configuration.nix | legacy/*)
        continue
        ;;
    esac

    lines="$(wc -l <"$file")"
    if (( lines > max_nix_lines )); then
      printf '%s has %s lines; split active Nix files before they exceed %s lines\n' \
        "$file" "$lines" "$max_nix_lines" >&2
      failed=1
    fi
  done < <(
    find flake.nix hosts modules rices home packages lib \
      -type f \
      -name '*.nix' \
      -print 2>/dev/null | sort
  )

  if (( failed )); then
    exit 1
  fi
}

run_eval_check() {
  nix flake check --all-systems --no-build
}

ensure_no_rebuild_running() {
  local pattern

  pattern='(^|[[:space:]/])(nh[[:space:]]+(os|darwin)[[:space:]]+(build|switch)|darwin-rebuild[[:space:]]+(build|switch)|nixos-rebuild[[:space:]]+(build|switch))([[:space:]]|$)'

  if command -v pgrep >/dev/null 2>&1 && pgrep -f "$pattern" >/dev/null 2>&1; then
    echo "another rebuild or switch is already running" >&2
    exit 1
  fi
}

mode="${1:-linux}"

case "$mode" in
  structure|eval|linux|darwin)
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

run_structure_check

if [[ "$mode" == "structure" ]]; then
  exit 0
fi

run_eval_check

case "$mode" in
  eval)
    ;;
  linux)
    ensure_no_rebuild_running
    nh os build . -H nixos
    nh os build . -H nvidia-desktop
    nh os build . -H nixos-server
    nh os build . -H wsl
    ;;
  darwin)
    ensure_no_rebuild_running
    nh darwin build . -H macbook-rift
    ;;
esac
