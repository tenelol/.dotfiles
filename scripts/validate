#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

usage() {
  cat <<'EOF'
Usage: ./scripts/validate <eval|linux|darwin>

  eval    Run flake checks without building outputs
  linux   Run no-build flake checks, then build all Linux hosts with nh
  darwin  Run no-build flake checks, then build the macOS host with nh
EOF
}

run_eval_check() {
  nix flake check --all-systems --no-build
}

mode="${1:-linux}"

case "$mode" in
  eval|linux|darwin)
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

run_eval_check

case "$mode" in
  eval)
    ;;
  linux)
    nh os build . -H nixos
    nh os build . -H nvidia-desktop
    nh os build . -H nixos-server
    nh os build . -H wsl
    ;;
  darwin)
    nh darwin build . -H macbook-rift
    ;;
esac
