def parse_assignment_target(args, *, require_pid=False, require_data=False, action="submit"):
    course_id = ""
    problem_id = ""
    pid = ""
    data_arg = ""
    file_path = ""
    positionals = []
    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg == "--course-id":
            idx += 1
            course_id = args[idx] if idx < len(args) else ""
        elif arg == "--problem-id":
            idx += 1
            problem_id = args[idx] if idx < len(args) else ""
        elif arg == "--pid":
            idx += 1
            pid = args[idx] if idx < len(args) else ""
        elif arg == "--data":
            idx += 1
            data_arg = args[idx] if idx < len(args) else ""
        elif arg.startswith("--"):
            raise ValueError(f"unknown assignment argument: {arg}")
        else:
            positionals.append(arg)
        idx += 1
    if not course_id and positionals:
        course_id = positionals.pop(0)
    if not problem_id and positionals:
        problem_id = positionals.pop(0)
    if require_pid and not file_path and positionals:
        file_path = positionals.pop(0)
    if positionals:
        raise ValueError(f"unexpected assignment argument: {positionals[0]}")
    if not course_id or not problem_id:
        raise ValueError(f"usage: imoocs assignment {action} <courseId> <problemId>")
    if require_pid and not pid:
        raise ValueError("assignment upload requires --pid")
    if require_pid and not file_path:
        raise ValueError("assignment upload requires a file path")
    if require_data and not data_arg:
        raise ValueError("assignment submit requires --data")
    return course_id, problem_id, pid, data_arg, file_path


def read_json_arg(value):
    source = value
    if value.startswith("@"):
        source = Path(value[1:]).read_text()
    data = json.loads(source)
    if not isinstance(data, dict):
        raise ValueError("assignment submit data must be a JSON object keyed by pid")
    return data


