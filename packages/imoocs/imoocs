def auth_required_payload(url, store_status):
    return envelope(
        False,
        "open",
        "route",
        "auth_required",
        {
            "url": url,
            "cookieStore": store_status,
            "next": [
                "Run `imoocs auth login`, then retry `imoocs open <url>`.",
                "No BrowserUse, Playwright, or manual browser fallback was performed.",
            ],
        },
        "auth_required",
        "MOOCs authentication is required or the stored session expired.",
    )


def open_url(url):
    try:
        validate_moocs_url(url)
    except ValueError as exc:
        print_json(envelope(False, "open", "route", "invalid_args", {"url": url}, "invalid_url", str(exc)))
        return 64

    jar, store_status = load_cookie_jar()
    if store_status != "loaded":
        print_json(auth_required_payload(url, store_status))
        return 2
    if not ensure_moocs_authenticated(jar):
        print_json(auth_required_payload(url, "expired"))
        return 2
    try:
        save_cookie_jar(jar)
    except Exception:
        pass

    final_url, status, _headers, body = request(jar, url)
    page_html = decode_body(body)
    if not (200 <= status < 400):
        print_json(envelope(False, "open", "route", "http_error", {"url": url, "httpStatus": status}, "http_error", f"MOOCs returned HTTP {status}"))
        return 2
    if looks_like_login_page(page_html, final_url):
        print_json(auth_required_payload(url, "expired"))
        return 2

    token = csrf_token(page_html)
    content_html = main_content(page_html)
    title = page_title(page_html, urllib.parse.unquote(urllib.parse.urlparse(final_url).path.rstrip("/").split("/")[-1] or "MOOCs"))
    body_text = text_from_html(content_html)
    links = extract_anchor_links(content_html, final_url)
    material_links = extract_google_material_links(page_html, final_url)
    route = route_from_url(final_url)
    descriptors = problem_descriptors(page_html, final_url)
    problems = [resolve_problem(jar, descriptor, final_url, token) for descriptor in descriptors]
    problem = problems[0] if problems else None

    for resolved_problem in problems:
        if resolved_problem["bodyText"]:
            body_text = "\n\n".join(part for part in [body_text, resolved_problem["bodyText"]] if part)
    if problem:
        # Keep the legacy route alias pointed at the first problem on the page.
        route["problemId"] = problem["problemId"]

    assignments = []
    for resolved_problem in problems:
        assignment = {
            "courseId": route.get("courseId"),
            "lessonId": route.get("lessonId"),
            "pageId": route.get("pageId"),
            "problemId": resolved_problem["problemId"],
            "title": title,
            "urlPrefix": resolved_problem["urlPrefix"],
            "bodyText": resolved_problem["bodyText"],
            "fields": resolved_problem["fields"],
            "currentAnswers": resolved_problem["currentAnswers"],
            "currentAnswerDetails": resolved_problem["currentAnswerDetails"],
            "status": resolved_problem["status"],
            "isSubmittable": resolved_problem["isSubmittable"],
        }
        if "language" in resolved_problem:
            assignment["language"] = resolved_problem["language"]
        if "endpointErrors" in resolved_problem:
            assignment["endpointErrors"] = resolved_problem["endpointErrors"]
        assignments.append(assignment)

    data = {
        "url": url,
        "finalUrl": final_url,
        "route": route,
        "title": title,
        "bodyText": body_text,
        "links": links,
        "materialLinks": material_links,
        "problem": problem,
        "assignmentCount": len(assignments),
        "assignments": assignments,
    }
    print_json(envelope(True, "open", "route", "resolved", data))
    return 0


def assignment_url_prefix(course_id, problem_id):
    if not course_id or not problem_id:
        raise ValueError("courseId and problemId are required")
    if any(part in ("", ".", "..") for part in course_id.split("/")):
        raise ValueError("invalid courseId")
    if "/" in problem_id or problem_id in ("", ".", ".."):
        raise ValueError("invalid problemId")
    course_path = "/".join(urllib.parse.quote(part, safe="") for part in course_id.split("/"))
    return f"{BASE_URL}/assignments/{course_path}/{urllib.parse.quote(problem_id, safe='')}"


