  local confirm="false"
  local course_id=""
  local problem_id=""
  local file_path=""
  local text_value=""
  local draft_dir="${IMOOCS_DRAFT_DIR:-$PWD/.imoocs/drafts}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --confirm)
        confirm="true"
        shift
        ;;
      --course-id)
        course_id="${2:-}"
        shift 2
        ;;
      --problem-id)
        problem_id="${2:-}"
        shift 2
        ;;
      --file)
        file_path="${2:-}"
        shift 2
        ;;
      --text)
        text_value="${2:-}"
        shift 2
        ;;
      *)
