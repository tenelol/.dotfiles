        " PNG image",
        " Microsoft Word",
        " Microsoft Excel",
        " Microsoft PowerPoint",
        " Text",
    )
    for suffix in suffixes:
        if value.endswith(suffix):
            return value[: -len(suffix)].strip()
    return value


def drive_name_from_row(row):
    patterns = (
        r"""(?is)<strong\b[^>]*class=["'][^"']*\bDNoYtb\b[^"']*["'][^>]*>(.*?)</strong>""",
        r"""(?is)<span\b[^>]*class=["'][^"']*\bWQJtxb\b[^"']*["'][^>]*>(.*?)</span>""",
    )
    for pattern in patterns:
        match = re.search(pattern, row)
        if match:
            name = text_from_html(match.group(1))
            if name:
                return name

    tooltip = attr("data-tooltip", row) or ""
    if tooltip:
        return drive_clean_tooltip_name(tooltip)
    aria = attr("aria-label", row) or ""
    if aria:
        return drive_clean_tooltip_name(aria)
    return ""


def drive_infer_mime(name, row, is_folder):
    if is_folder:
        return "application/vnd.google-apps.folder"
    match = re.search(
        r"""(?i)application/(?:vnd\.google-apps\.[A-Za-z0-9_.-]+|pdf|zip|x-zip-compressed|octet-stream)|text/[a-z0-9_.+-]+|image/[a-z0-9_.+-]+""",
        row,
    )
    if match:
        return match.group(0)
    guessed, _encoding = mimetypes.guess_type(name)
    return guessed or ""


def drive_item_from_row(row, index, mime_by_id):
    file_id = attr("data-id", row)
    if not file_id:
        return None

    name = drive_name_from_row(row) or file_id
    tooltip = attr("data-tooltip", row) or ""
    is_folder = (
        "Shared folder" in tooltip
        or tooltip.endswith(" Folder")
        or "application/vnd.google-apps.folder" in row
    )
    mime_type = mime_by_id.get(file_id) or drive_infer_mime(name, row, is_folder)
    if mime_type == "application/vnd.google-apps.folder":
        is_folder = True

    return {
        "index": index,
        "id": file_id,
        "name": name,
        "kind": "folder" if is_folder else "file",
        "mimeType": mime_type,
        "url": drive_folder_url(file_id) if is_folder else drive_file_url(file_id),
    }


def list_drive_folder(jar, folder_id):
    final_url, page_html = drive_fetch_folder_page(jar, folder_id)
    mime_by_id = drive_mimes_from_page(page_html)
    items = []
    seen = set()
    for match in re.finditer(r"""(?is)<tr\b[^>]*\bdata-id=["'][^"']+["'][^>]*>.*?</tr>""", page_html):
        item = drive_item_from_row(match.group(0), len(items), mime_by_id)
        if not item or item["id"] in seen:
            continue
        seen.add(item["id"])
        items.append(item)
    return {
        "folderId": folder_id,
        "folderUrl": final_url,
        "items": items,
    }


def parse_drive_args(args, action):
    options = {
        "parent": DEFAULT_DRIVE_PARENT_FOLDER_ID,
        "path": "",
        "recursive": False,
        "max_depth": 8,
        "limit": 0,
        "overwrite": False,
        "matches": [],
    }
    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg in ("-h", "--help"):
            if action == "collect":
                print("""Usage:
  imoocs drive collect --path <dir> [--parent <drive-folder-url-or-id>] [--recursive] [--match <text>] [--limit <n>] [--overwrite]

The default --parent is the configured INIAD 2026 Drive folder.
With --match, matching direct child folders are collected recursively.
""".rstrip())
            else:
                print("""Usage:
  imoocs drive ls [--parent <drive-folder-url-or-id>] [--recursive] [--match <text>]

The default --parent is the configured INIAD 2026 Drive folder.
""".rstrip())
            raise SystemExit(0)
        if arg in ("--parent", "--folder", "--folder-id"):
            idx += 1
            if idx >= len(args):
                raise ValueError(f"{arg} requires a value")
            options["parent"] = args[idx]
            idx += 1
            continue
        if arg in ("--path", "--output"):
            idx += 1
            if idx >= len(args):
                raise ValueError(f"{arg} requires a value")
            options["path"] = args[idx]
            idx += 1
            continue
        if arg == "--recursive":
            options["recursive"] = True
            idx += 1
            continue
        if arg == "--max-depth":
            idx += 1
            if idx >= len(args):
                raise ValueError("--max-depth requires a value")
            options["max_depth"] = int(args[idx])
            idx += 1
            continue
        if arg == "--limit":
            idx += 1
            if idx >= len(args):
                raise ValueError("--limit requires a value")
            options["limit"] = int(args[idx])
            idx += 1
            continue
        if arg == "--match":
            idx += 1
            if idx >= len(args):
                raise ValueError("--match requires a value")
            options["matches"].append(args[idx])
            idx += 1
            continue
        if arg == "--overwrite":
            options["overwrite"] = True
            idx += 1
            continue
        raise ValueError(f"unknown argument for drive {action}: {arg}")

    options["parentFolderId"] = drive_folder_id_from_value(options["parent"])
    if action == "collect" and not options["path"]:
        raise ValueError("drive collect requires --path")
    if options["max_depth"] < 0:
        raise ValueError("--max-depth must be >= 0")
    if options["limit"] < 0:
        raise ValueError("--limit must be >= 0")
    return options


def drive_matches(item, matches):
    if not matches:
        return True
    name = item.get("name", "").casefold()
    return all(token.casefold() in name for token in matches)


def drive_selected_items(items, matches):
    if not matches:
        return items
    return [item for item in items if drive_matches(item, matches)]


def drive_load_google_jar(action, parent_id, browser_import_attempted=False):
    jar, store_status = load_cookie_jar()
    if store_status in ("missing_keyring", "keyring_unavailable"):
        print_json(drive_auth_required_payload(action, parent_id, store_status))
        raise SystemExit(2)

    browser_import = None
    if store_status != "loaded" or not has_google_auth_cookie(jar):
        if not browser_import_attempted:
            browser_import = maybe_import_google_cookies_from_browser(jar)
            if browser_import.get("ok"):
                return jar, browser_import
        print_json(drive_auth_required_payload(action, parent_id, store_status, browser_import))
        raise SystemExit(2)

    return jar, browser_import


def drive_list_entries(jar, folder_id, *, recursive=False, max_depth=8, matches=None):
    matches = matches or []
    entries = []
    errors = []
    seen_folders = set()

    def visit(current_folder_id, relative_parts, depth, root=False):
        if current_folder_id in seen_folders:
            return
        seen_folders.add(current_folder_id)
        listing = list_drive_folder(jar, current_folder_id)
        items = drive_selected_items(listing["items"], matches) if root else listing["items"]
        for item in items:
            entry = dict(item)
            entry["depth"] = depth
            entry["parentFolderId"] = current_folder_id
            entry["relativePath"] = "/".join([*relative_parts, item["name"]])
            entries.append(entry)
            should_descend = item["kind"] == "folder" and recursive and depth < max_depth
            if should_descend:
                try:
                    visit(item["id"], [*relative_parts, item["name"]], depth + 1)
                except GoogleAuthRequired:
                    raise
                except Exception as exc:
                    errors.append({
                        "folderId": item["id"],
                        "name": item["name"],
                        "message": str(exc),
                    })

    visit(folder_id, [], 0, root=True)
    return entries, errors


def filename_from_content_disposition(value):
    def decode_filename(filename):
        filename = html.unescape(filename).strip()
        try:
            return filename.encode("latin-1").decode("utf-8")
        except (UnicodeEncodeError, UnicodeDecodeError):
            return filename

    if not value:
        return ""
    match = re.search(r"""filename\*\s*=\s*UTF-8''([^;]+)""", value, flags=re.I)
    if match:
        return decode_filename(urllib.parse.unquote(match.group(1).strip().strip('"')))
    match = re.search(r'''filename\s*=\s*"([^"]+)"''', value, flags=re.I)
    if match:
        return decode_filename(match.group(1))
    match = re.search(r"""filename\s*=\s*([^;]+)""", value, flags=re.I)
    if match:
        return decode_filename(match.group(1))
    return ""


def google_app_export_url(file_id, mime_type):
    quoted = urllib.parse.quote(file_id, safe="")
    if mime_type == "application/vnd.google-apps.presentation":
        return f"https://docs.google.com/presentation/d/{quoted}/export/pdf", ".pdf"
    if mime_type == "application/vnd.google-apps.document":
        return f"https://docs.google.com/document/d/{quoted}/export?format=pdf", ".pdf"
    if mime_type == "application/vnd.google-apps.spreadsheet":
        return f"https://docs.google.com/spreadsheets/d/{quoted}/export?format=xlsx", ".xlsx"
    return "", ""


def drive_confirm_url(page_html, page_url):
    for match in re.finditer(r"""(?is)<a\b[^>]*\bhref=["']([^"']+)["']""", page_html):
        href = html.unescape(match.group(1))
        if "confirm=" in href and ("id=" in href or "/download" in href):
            return urllib.parse.urljoin(page_url, href)
    form = find_form(
        page_html,
        page_url,
        lambda _attrs, body, form_html: "confirm" in body.lower() and "download" in form_html.lower(),
    )
    if form:
        action_url, fields, _attrs, _body = form
        if fields:
            return action_url + ("&" if "?" in action_url else "?") + urllib.parse.urlencode(fields)
    return ""


def downloadable_drive_response(final_url, headers, body):
    content_type = header_value(headers, "Content-Type").lower()
    if body.startswith((b"PK\x03\x04", b"%PDF", b"\x89PNG\r\n\x1a\n", b"\xff\xd8")):
        return True
    if header_value(headers, "Content-Disposition"):
        return True
    return "text/html" not in content_type


def filename_with_detected_suffix(filename, headers, body):
    if Path(filename).suffix:
        return filename
    if body.startswith(b"%PDF"):
        return f"{filename}.pdf"
    if body.startswith(b"PK\x03\x04"):
        return f"{filename}.zip"
    if body.startswith(b"\x89PNG\r\n\x1a\n"):
        return f"{filename}.png"
    if body.startswith(b"\xff\xd8"):
        return f"{filename}.jpg"
    content_type = header_value(headers, "Content-Type").split(";", 1)[0].strip().lower()
    suffix = mimetypes.guess_extension(content_type) if content_type else ""
    return f"{filename}{suffix or ''}"


def try_drive_download_url(jar, url, referer=""):
    request_headers = {"Accept": "application/octet-stream,application/pdf,application/zip,*/*;q=0.8"}
    if referer:
        request_headers["Referer"] = referer
    final_url, status, headers, body = request(jar, url, headers=request_headers, timeout=300)
    page_html = decode_body(body) if body else ""
    if looks_like_google_login_page(final_url, page_html):
        raise GoogleAuthRequired("Google Drive authentication is required")
    if 200 <= status < 400 and downloadable_drive_response(final_url, headers, body):
        return (final_url, headers, body), None

    confirm_url = drive_confirm_url(page_html, final_url)
    if confirm_url:
        final_url, status, headers, body = request(
            jar,
            confirm_url,
            headers={
                "Accept": "application/octet-stream,application/pdf,application/zip,*/*;q=0.8",
                "Referer": final_url,
            },
            timeout=300,
        )
        page_html = decode_body(body) if body else ""
        if looks_like_google_login_page(final_url, page_html):
            raise GoogleAuthRequired("Google Drive authentication is required")
        if 200 <= status < 400 and downloadable_drive_response(final_url, headers, body):
            return (final_url, headers, body), None

    return None, {"status": status, "url": final_url}


def download_drive_file_body(jar, item):
    export_url, export_suffix = google_app_export_url(item["id"], item.get("mimeType", ""))
    file_id = item["id"]
    encoded_id = urllib.parse.quote(file_id, safe="")
    candidates = [export_url] if export_url else [
        "https://drive.usercontent.google.com/download?" + urllib.parse.urlencode({
            "id": file_id,
            "export": "download",
        }),
        f"https://drive.google.com/uc?export=download&id={encoded_id}",
        f"https://drive.google.com/uc?id={encoded_id}&export=download",
    ]
    failures = []
    referer = drive_file_url(file_id)

    for url in dict.fromkeys(candidates):
        result, failure = try_drive_download_url(jar, url, referer)
        if result:
            final_url, headers, body = result
            filename = filename_from_content_disposition(header_value(headers, "Content-Disposition")) or item["name"]
            if export_suffix and not filename.lower().endswith(export_suffix):
                filename = f"{Path(filename).stem or item['name']}{export_suffix}"
            return final_url, headers, filename, body
        failures.append(failure)

    view_final_url, view_status, view_headers, view_body = request(
        jar,
        referer,
        headers={"Accept": "text/html,application/xhtml+xml,*/*;q=0.8"},
        timeout=120,
    )
    view_html = decode_body(view_body) if view_body else ""
    if looks_like_google_login_page(view_final_url, view_html):
        raise GoogleAuthRequired("Google Drive authentication is required")
    if is_google_presentation_url(view_final_url):
        source_url, body = fetch_slide_pdf(jar, view_final_url)
        filename = f"{Path(item['name']).stem or item['id']}.pdf"
        return source_url, {"Content-Type": "application/pdf"}, filename, body

    detected_mime = drive_infer_mime(item["name"], view_html, False)
    detected_export_url, detected_suffix = google_app_export_url(file_id, detected_mime)
    if detected_export_url:
        result, failure = try_drive_download_url(jar, detected_export_url, view_final_url)
        if result:
            final_url, headers, body = result
            filename = filename_from_content_disposition(header_value(headers, "Content-Disposition")) or item["name"]
            if detected_suffix and not filename.lower().endswith(detected_suffix):
                filename = f"{Path(filename).stem or item['name']}{detected_suffix}"
            return final_url, headers, filename, body
        failures.append(failure)

    failures.append({"status": view_status, "url": view_final_url})

    detail = "; ".join(f"HTTP {item['status']} {item['url']}" for item in failures)
    raise RuntimeError(f"Google Drive did not return a downloadable response ({detail})")


def unique_output_path(path):
    if not path.exists():
        return path
    stem = path.stem
    suffix = path.suffix
    parent = path.parent
    for counter in range(1, 1000):
        candidate = parent / f"{stem} ({counter}){suffix}"
        if not candidate.exists():
            return candidate
    raise RuntimeError(f"could not choose a unique output filename for {path}")


def drive_collect_files(jar, folder_id, out_dir, options):
    downloaded = []
    skipped = []
    errors = []
    seen_folders = set()
    limit = options["limit"]

    def collect_folder(current_folder_id, relative_parts, depth, root=False, force_recursive=False):
        if current_folder_id in seen_folders:
            return
        seen_folders.add(current_folder_id)
        listing = list_drive_folder(jar, current_folder_id)
        items = drive_selected_items(listing["items"], options["matches"]) if root else listing["items"]

        for item in items:
            if limit and len(downloaded) >= limit:
                skipped.append({
                    "id": item["id"],
                    "name": item["name"],
                    "reason": "limit_reached",
                })
                continue

            item_relative_parts = [*relative_parts, item["name"]]
            if item["kind"] == "folder":
                child_force_recursive = force_recursive or (root and bool(options["matches"]))
                should_descend = (
                    depth < options["max_depth"]
                    and (options["recursive"] or child_force_recursive)
                )
                if should_descend:
                    collect_folder(item["id"], item_relative_parts, depth + 1, force_recursive=child_force_recursive)
                else:
                    skipped.append({
                        "id": item["id"],
                        "name": item["name"],
                        "relativePath": "/".join(item_relative_parts),
                        "reason": "folder_not_recursive",
                    })
                continue

            try:
                source_url, headers, filename, body = download_drive_file_body(jar, item)
                file_dir = out_dir.joinpath(*(safe_filename(part) for part in relative_parts))
                file_dir.mkdir(parents=True, exist_ok=True)
                safe_name = safe_filename(filename or item["name"], item["id"])
                output_path = file_dir / safe_name
                if output_path.exists() and not options["overwrite"]:
                    output_path = unique_output_path(output_path)
                output_path.write_bytes(body)
                downloaded.append({
                    "id": item["id"],
                    "name": item["name"],
                    "path": str(output_path),
                    "relativePath": "/".join([*relative_parts, output_path.name]),
                    "bytes": len(body),
                    "mimeType": item.get("mimeType", ""),
                    "contentType": header_value(headers, "Content-Type"),
                    "sourceUrl": source_url,
                })
            except GoogleAuthRequired:
                raise
            except Exception as exc:
                errors.append({
                    "id": item["id"],
                    "name": item["name"],
                    "relativePath": "/".join(item_relative_parts),
                    "message": str(exc),
                })

    collect_folder(folder_id, [], 0, root=True)
    return downloaded, skipped, errors


def drive_ls(args, browser_import_attempted=False, browser_import=None):
    try:
        options = parse_drive_args(args, "ls")
    except SystemExit:
        raise
    except Exception as exc:
        print_json(envelope(False, "drive", "ls", "invalid_args", {}, "invalid_args", str(exc)))
        return 64

    parent_id = options["parentFolderId"]
    try:
        jar, import_info = drive_load_google_jar("ls", parent_id, browser_import_attempted)
        browser_import = browser_import or import_info
        entries, errors = drive_list_entries(
            jar,
            parent_id,
            recursive=options["recursive"],
            max_depth=options["max_depth"],
            matches=options["matches"],
        )
        try:
            save_cookie_jar(jar)
        except Exception:
            pass
    except GoogleAuthRequired:
        if not browser_import_attempted:
            jar, _store_status = load_cookie_jar()
            browser_import = maybe_import_google_cookies_from_browser(jar)
            if browser_import.get("ok"):
                return drive_ls(args, browser_import_attempted=True, browser_import=browser_import)
        print_json(drive_auth_required_payload("ls", parent_id, "google_expired", browser_import))
        return 2
    except HttpStatusError as exc:
        print_json(envelope(
            False,
            "drive",
            "ls",
            "http_error",
            {"parentFolderId": parent_id, "url": exc.url, "httpStatus": exc.status},
            "http_error",
            str(exc),
        ))
        return 2
    except Exception as exc:
        print_json(envelope(
            False,
            "drive",
            "ls",
            "failed",
            {"parentFolderId": parent_id, "parentFolderUrl": drive_folder_url(parent_id)},
            "drive_ls_failed",
            str(exc),
        ))
        return 2

    status = "partial" if errors else "listed"
    print_json(envelope(
        not errors,
        "drive",
        "ls",
        status,
        {
            "parentFolderId": parent_id,
            "parentFolderUrl": drive_folder_url(parent_id),
            "defaultParentFolderUrl": DEFAULT_DRIVE_PARENT_FOLDER_URL,
            "recursive": options["recursive"],
            "maxDepth": options["max_depth"],
            "match": options["matches"],
            "itemCount": len(entries),
            "items": entries,
            "errors": errors,
            "browserCookieImport": browser_import,
        },
        "drive_ls_failed" if errors else "",
        "one or more Drive folders failed to list" if errors else "",
    ))
    return 2 if errors else 0


