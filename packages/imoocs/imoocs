def google_continue_url(page_html, page_url):
    links = []
    for match in re.finditer(r"""(?is)<a\s+(?:[^>]*?\s+)?href=["']([^"']*)["']""", page_html):
        href = html.unescape(match.group(1))
        lowered = href.lower()
        if lowered.startswith(("javascript:", "mailto:", "tel:", "#")):
            continue
        url = urllib.parse.urljoin(page_url, href)
        text = text_from_html(match.group(0)).lower()
        score = 0
        if "continue" in text or "続行" in text:
            score += 10
        parsed = urllib.parse.urlparse(url)
        if parsed.hostname and parsed.hostname.endswith("google.com"):
            score += 5
        links.append((score, url))
    if not links:
        return None
    links.sort(reverse=True)
    return links[0][1]


def meta_refresh_url(page_html, page_url):
    match = re.search(
        r"""(?is)<meta\s+[^>]*http-equiv=["']refresh["'][^>]*content=["'][^"']*\burl=([^"'>]+)["']""",
        page_html,
    )
    if not match:
        return None
    return urllib.parse.urljoin(page_url, html.unescape(match.group(1)))


def javascript_redirect_url(page_html, page_url):
    patterns = (
        r"""(?is)(?:window|document)\.location(?:\.href)?\s*=\s*["']([^"']+)["']""",
        r"""(?is)(?:window\.)?location\.replace\(\s*["']([^"']+)["']\s*\)""",
    )
    for pattern in patterns:
        match = re.search(pattern, page_html)
        if match:
            target = html.unescape(match.group(1)).replace("\\/", "/")
            if "\\" in target:
                continue
            url = urllib.parse.urljoin(page_url, target)
            parsed = urllib.parse.urlparse(url)
            if parsed.hostname and parsed.hostname.endswith(("google.com", "googleusercontent.com")):
                return url
    return None


def google_hidden_post_form(page_html, page_url):
    candidates = []
    for match in re.finditer(r"(?is)<form\b([^>]*)>(.*?)</form>", page_html):
        attrs = match.group(1)
        body = match.group(2)
        form_html = match.group(0)
        lowered = form_html.lower()
        if "name=\"password\"" in lowered or "name='password'" in lowered:
            continue
        if "name=\"username\"" in lowered or "name='username'" in lowered:
            continue

        fields = form_hidden_fields(body)
        if not fields:
            continue

        action = attr("action", attrs) or page_url
        action_url = urllib.parse.urljoin(page_url, action)
        parsed = urllib.parse.urlparse(action_url)
        name = attr("name", attrs) or ""

        score = 0
        if name in ("saml-post-binding", "hiddenpost"):
            score += 20
        if {"SAMLResponse", "RelayState"} <= set(fields):
            score += 15
        if parsed.hostname and parsed.hostname.endswith("google.com"):
            score += 10
        if "continue" in fields:
            score += 2
        candidates.append((score, action_url, fields))

    if not candidates:
        return None
    candidates.sort(key=lambda item: item[0], reverse=True)
    return candidates[0][1], candidates[0][2]


def google_authuser_from_url(url):
    parsed = urllib.parse.urlparse(url)
    query_authuser = urllib.parse.parse_qs(parsed.query).get("authuser", [])
    if query_authuser and query_authuser[0].isdigit():
        return query_authuser[0]
    parts = [urllib.parse.unquote(part) for part in parsed.path.split("/") if part]
    for index, part in enumerate(parts[:-1]):
        if part == "u" and parts[index + 1].isdigit():
            return parts[index + 1]
    return ""


