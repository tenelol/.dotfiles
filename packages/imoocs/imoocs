# Python can otherwise hang on this network while connecting to Google ACS
# IPv6 addresses. Curl succeeds because it races IPv4/IPv6; prefer IPv4 here.
_ORIGINAL_GETADDRINFO = socket.getaddrinfo


def prefer_ipv4_getaddrinfo(host, port, family=0, type=0, proto=0, flags=0):
    infos = _ORIGINAL_GETADDRINFO(host, port, family, type, proto, flags)
    return sorted(infos, key=lambda item: 0 if item[0] == socket.AF_INET else 1)


socket.getaddrinfo = prefer_ipv4_getaddrinfo

