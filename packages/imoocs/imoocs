def password_from_keychain(username):
    security = "/usr/bin/security"
    if os.path.exists(security):
        for service in KEYCHAIN_PASSWORD_SERVICES:
            try:
                result = subprocess.run(
                    [
                        security,
                        "find-generic-password",
                        "-s",
                        service,
                        "-a",
                        username,
                        "-w",
                    ],
                    check=False,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=KEYCHAIN_SECURITY_TIMEOUT_SECONDS,
                )
            except (FileNotFoundError, subprocess.TimeoutExpired):
                result = None
            if result is not None and result.returncode == 0:
                return result.stdout.rstrip("\n")

    keyring_helper = """
import sys

services = (
    "me.yu7400ki.moocs-collect",
    "com.apple.network.eap.user.item.wlan.ssid.iniad",
)
username = sys.argv[1]

try:
    import keyring
except Exception:
    raise SystemExit(1)

for service in services:
    try:
        password = keyring.get_password(service, username)
    except Exception:
        continue
    if password:
        sys.stdout.write(password)
        raise SystemExit(0)

raise SystemExit(1)
""".strip()
    try:
        result = subprocess.run(
            [sys.executable, "-c", keyring_helper, username],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=KEYCHAIN_SECURITY_TIMEOUT_SECONDS,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        result = None
    if result is not None and result.returncode == 0 and result.stdout:
        return result.stdout.rstrip("\n")
    return None


def form_origin(url):
    parsed = urllib.parse.urlparse(url)
    return urllib.parse.urlunparse((parsed.scheme, parsed.netloc, "", "", "", ""))


def post_form(jar, action_url, fields, referer):
