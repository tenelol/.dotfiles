def drive_folder_id_from_value(value):
    value = (value or DEFAULT_DRIVE_PARENT_FOLDER_ID).strip()
    if not value:
        return DEFAULT_DRIVE_PARENT_FOLDER_ID

    parsed = urllib.parse.urlparse(value)
    if parsed.scheme and parsed.netloc:
        parts = [urllib.parse.unquote(part) for part in parsed.path.split("/") if part]
        for index, part in enumerate(parts[:-1]):
            if part == "folders":
                return parts[index + 1]
        query_id = urllib.parse.parse_qs(parsed.query).get("id", [])
        if query_id:
            return query_id[0]
        raise ValueError("Drive folder URL must contain /folders/<id> or ?id=<id>")

    if re.fullmatch(r"[A-Za-z0-9_-]{10,}", value):
        return value
    raise ValueError("Drive folder id was not recognized")


def drive_file_id_from_value(value):
    parsed = urllib.parse.urlparse((value or "").strip())
    parts = [urllib.parse.unquote(part) for part in parsed.path.split("/") if part]
    for marker in ("file", "document", "presentation", "spreadsheets"):
        for index in range(len(parts) - 2):
            if parts[index] == marker and parts[index + 1] == "d":
                return parts[index + 2]
    query_id = urllib.parse.parse_qs(parsed.query).get("id", [])
    if query_id:
        return query_id[0]
    raise ValueError("Drive file URL must contain /file/d/<id>, a Google app /d/<id>, or ?id=<id>")


def drive_mime_from_url(value):
    path = urllib.parse.urlparse(value).path
    if "/presentation/d/" in path:
        return "application/vnd.google-apps.presentation"
    if "/document/d/" in path:
        return "application/vnd.google-apps.document"
    if "/spreadsheets/d/" in path:
        return "application/vnd.google-apps.spreadsheet"
    return ""


def drive_folder_url(folder_id):
    return f"https://drive.google.com/drive/u/0/folders/{urllib.parse.quote(folder_id, safe='')}"


def drive_file_url(file_id):
    return f"https://drive.google.com/file/d/{urllib.parse.quote(file_id, safe='')}/view"


def looks_like_google_login_page(final_url, page_html):
    parsed = urllib.parse.urlparse(final_url)
    lower = page_html.lower()
    return (
        parsed.hostname == "accounts.google.com"
        or "servicelogin" in parsed.path.lower()
        or "signin/v2" in parsed.path.lower()
        or "identifierid" in lower
        or "signin" in lower and "accounts.google.com" in lower
    )


def header_value(headers, name):
    wanted = name.lower()
    for key, value in headers.items():
        if key.lower() == wanted:
            return value
    return ""


def drive_fetch_folder_page(jar, folder_id):
    url = drive_folder_url(folder_id)
    final_url, status, headers, body = request(jar, url, timeout=60)
    page_html = decode_body(body)

    # Existing Google cookies sometimes need one account-selection transition.
    if looks_like_google_login_page(final_url, page_html):
        try:
            if refresh_google_target_access(jar, url, final_url, page_html):
                final_url, status, headers, body = request(jar, url, timeout=60)
                page_html = decode_body(body)
        except Exception:
            pass

    if not (200 <= status < 400):
        raise HttpStatusError(final_url, status)
    if looks_like_google_login_page(final_url, page_html):
        raise GoogleAuthRequired("Google Drive authentication is required")
    if "data-id=" not in page_html and "AF_initDataCallback" not in page_html:
        raise RuntimeError("Google Drive folder listing was not found in the response")
    return final_url, page_html


def drive_mimes_from_page(page_html):
    mimes = {}
    pattern = r'''\[\[null,"([A-Za-z0-9_-]{10,})"\],null,null,null,"([^"]+)'''
    for match in re.finditer(pattern, page_html):
        mimes.setdefault(match.group(1), html.unescape(match.group(2)))
    return mimes


