def google_login_url_for_target(target_url):
    email = google_account_email_from_env()
    if email:
        return google_accountchooser_url_for_target(target_url, email)
    query = [
        ("service", "wise"),
        ("passive", "1209600"),
        ("osid", "1"),
        ("continue", target_url),
        ("followup", target_url),
        ("ltmpl", "slides"),
    ]
    authuser = google_authuser_from_url(target_url)
    if authuser:
        query.append(("authuser", authuser))
    return "https://accounts.google.com/ServiceLogin?" + urllib.parse.urlencode(query)


def google_service_login_url(page_html, page_url):
    for match in re.finditer(
        r"""(?is)\b(?:data-popup-url|href)\s*=\s*(?:"([^"]+)"|'([^']+)'|([^\s>]+))""",
        page_html,
    ):
        raw = next((group for group in match.groups() if group), "")
        if not raw:
            continue
        url = html.unescape(raw).strip()
        if url.startswith("//"):
            url = "https:" + url
        url = urllib.parse.urljoin(page_url, url)
        parsed = urllib.parse.urlparse(url)
        if parsed.hostname == "accounts.google.com" and "servicelogin" in parsed.path.lower():
            return url
    return ""


def follow_google_target_transitions(jar, initial_url, target_url=""):
    final_url, status, _headers, body = request(jar, initial_url, timeout=60)
    page_html = decode_body(body)
    progressed = True
    selected_account_emails = set()

    for _ in range(12):
        account_email = google_account_email_from_page(page_html)
        if account_email and account_email not in selected_account_emails:
            selected_account_emails.add(account_email)
            chooser_url = google_accountchooser_url_for_target(target_url or final_url, account_email)
            final_url, status, _headers, body = request(jar, chooser_url, timeout=60)
            if not (200 <= status < 400):
                return progressed
            page_html = decode_body(body)
            progressed = True
            continue

        form = google_hidden_post_form(page_html, final_url)
        if form:
            action_url, fields = form
            final_url, status, _headers, body = post_form(jar, action_url, fields, final_url)
            if not (200 <= status < 400):
                return progressed
            page_html = decode_body(body)
            progressed = True
            continue

        next_url = (
            meta_refresh_url(page_html, final_url)
            or javascript_redirect_url(page_html, final_url)
            or google_continue_url(page_html, final_url)
            or google_service_login_url(page_html, final_url)
        )
        if next_url:
            final_url, status, _headers, body = request(jar, next_url, timeout=60)
            if not (200 <= status < 400):
                return progressed
            page_html = decode_body(body)
            progressed = True
            continue

        break

    return progressed


def refresh_google_target_access(jar, target_url, final_url, page_html):
    target = final_url or target_url
    if google_authuser_from_url(target):
        login_url = google_login_url_for_target(target)
    else:
        login_url = google_service_login_url(page_html, final_url) or google_login_url_for_target(target)
    return follow_google_target_transitions(jar, login_url, target_url)


GOOGLE_AUTH_COOKIE_NAMES = {
    "SID",
    "HSID",
    "SSID",
    "APISID",
    "SAPISID",
    "__Secure-1PSID",
    "__Secure-3PSID",
    "__Secure-1PSIDTS",
    "__Secure-3PSIDTS",
    "__Secure-1PSIDCC",
    "__Secure-3PSIDCC",
}


def has_google_auth_cookie(jar):
    return bool(google_auth_cookie_names_in(jar))


def google_auth_cookie_names_in(jar):
    names = set()
    for cookie in jar:
        domain = cookie.domain.lstrip(".").lower()
        if domain.endswith("google.com") and cookie.name in GOOGLE_AUTH_COOKIE_NAMES:
            names.add(cookie.name)
    return sorted(names)


def browser_profile_roots():
    # Locate Chromium-family profile stores on macOS; unsupported platforms fall back.
    if sys.platform == "darwin":
        base = Path.home() / "Library" / "Application Support"
        return {
            "chrome": base / "Google" / "Chrome",
            "chromium": base / "Chromium",
            "brave": base / "BraveSoftware" / "Brave-Browser",
            "edge": base / "Microsoft Edge",
        }
    return {}


def browser_profile_info(base_dir):
    # Chrome Local State gives profile display names and account hints without secrets.
    local_state = base_dir / "Local State"
    try:
        data = json.loads(local_state.read_text())
    except Exception:
        return {}
    info_cache = data.get("profile", {}).get("info_cache", {})
    return info_cache if isinstance(info_cache, dict) else {}


def browser_profile_cookie_file(profile_dir):
    # Chrome versions have used both profile/Cookies and profile/Network/Cookies.
    for relative in ("Network/Cookies", "Cookies"):
        cookie_file = profile_dir / relative
        if cookie_file.exists():
            return cookie_file
    return None


def browser_profile_score(profile_dir_name, info):
    # Prefer INIAD profiles so auto import does not pick a personal Google account.
    values = [
        profile_dir_name,
        str(info.get("name", "")),
        str(info.get("user_name", "")),
        str(info.get("gaia_name", "")),
    ]
    text = " ".join(values).lower()
    score = 0
    if "iniad" in text:
        score += 100
    if "@iniad.org" in text:
        score += 50
    if info.get("user_name"):
        score += 10
    if profile_dir_name == "Default":
        score -= 5
    return score


def browser_profile_matches(profile_dir_name, info, requested_profile):
    # Accept either the profile directory, display name, account name, or Gaia name.
    if not requested_profile:
        return True
    wanted = requested_profile.strip().casefold()
    values = [
        profile_dir_name,
        str(info.get("name", "")),
        str(info.get("user_name", "")),
        str(info.get("gaia_name", "")),
    ]
    return any(value.strip().casefold() == wanted for value in values if value)


def chromium_profile_cookie_sources(browser_name, requested_profile=""):
    # Build cookie loader candidates in the order they should be attempted.
    roots = browser_profile_roots()
    base_dir = roots.get(browser_name)
    if not base_dir or not base_dir.exists():
        return []

    info_cache = browser_profile_info(base_dir)
    profile_names = set(info_cache)
    for profile_dir in base_dir.iterdir():
        if profile_dir.is_dir() and (profile_dir.name == "Default" or profile_dir.name.startswith("Profile ")):
            profile_names.add(profile_dir.name)

    sources = []
    for profile_name in sorted(profile_names):
        profile_dir = base_dir / profile_name
        if not profile_dir.is_dir():
            continue
        info = info_cache.get(profile_name, {})
        if not browser_profile_matches(profile_name, info, requested_profile):
            continue
        cookie_file = browser_profile_cookie_file(profile_dir)
        if not cookie_file:
            continue
        sources.append({
            "profile": profile_name,
            "profileName": str(info.get("name", "")),
            "userNamePresent": bool(info.get("user_name")),
            "cookieFile": str(cookie_file),
            "score": browser_profile_score(profile_name, info),
        })

    if not requested_profile:
        preferred_sources = [source for source in sources if source["score"] >= 100]
        if preferred_sources:
            sources = preferred_sources

    sources.sort(key=lambda item: (-item["score"], item["profile"]))
    return sources


def browser_cookie_loaders(browser, profile=""):
    if browser_cookie3 is None:
        raise RuntimeError(f"browser-cookie3 support is unavailable: {BROWSER_COOKIE3_ERROR}")

    aliases = {
        "google-chrome": "chrome",
        "chrome": "chrome",
        "chromium": "chromium",
        "brave": "brave",
        "edge": "edge",
        "msedge": "edge",
        "firefox": "firefox",
    }
    requested = (browser or "auto").strip().lower()
    if requested == "auto":
        names = ("chrome", "chromium", "brave", "edge", "firefox")
    elif requested in aliases:
        names = (aliases[requested],)
    else:
        raise ValueError("browser must be one of auto, chrome, chromium, brave, edge, or firefox")

    loaders = []
    for name in names:
        loader = getattr(browser_cookie3, name, None)
        if loader is None:
            continue
        profile_sources = chromium_profile_cookie_sources(name, profile)
        for source in profile_sources:
            loaders.append({
                "browser": name,
                "label": f"{name}:{source['profile']}",
                "loader": loader,
                "kwargs": {"cookie_file": source["cookieFile"], "domain_name": "google.com"},
                "profile": source["profile"],
                "profileName": source["profileName"],
                "userNamePresent": source["userNamePresent"],
            })
        if not profile_sources and not profile:
            loaders.append({
                "browser": name,
                "label": name,
                "loader": loader,
                "kwargs": {"domain_name": "google.com"},
                "profile": "",
                "profileName": "",
                "userNamePresent": False,
            })
    if not loaders:
        if profile:
            raise RuntimeError(f"no supported browser cookie loaders are available for profile {profile!r}")
        raise RuntimeError("no supported browser cookie loaders are available")
    return loaders


def import_google_cookies_from_browser(jar, browser="auto", profile=""):
    tried = []
    errors = []
    for spec in browser_cookie_loaders(browser, profile):
        tried.append(spec["label"])
        try:
            browser_jar = spec["loader"](**spec["kwargs"])
        except Exception as exc:
            errors.append({"browser": spec["label"], "message": str(exc)[:240]})
            continue

        # Validate this profile as a complete Google cookie set before saving it.
        candidate_jar = clone_cookie_jar(jar)
        clear_google_cookies(candidate_jar)
        imported = 0
        for cookie in browser_jar:
            domain = cookie.domain.lstrip(".").lower()
            if not domain.endswith("google.com"):
                continue
            candidate_jar.set_cookie(cookie)
            imported += 1

        auth_cookie_names = google_auth_cookie_names_in(candidate_jar)
        if auth_cookie_names:
            replace_cookie_jar(jar, candidate_jar)
            info = {
                "ok": True,
                "browser": spec["browser"],
                "profile": spec["profile"],
                "profileName": spec["profileName"],
                "userNamePresent": spec["userNamePresent"],
                "triedBrowsers": tried,
                "importedCookieCount": imported,
                "authCookieNames": auth_cookie_names,
                "errors": errors,
            }
            return info

        errors.append({
            "browser": spec["label"],
            "message": "Google cookies were readable, but Google auth cookies were not found.",
        })

    detail = "; ".join(f"{item['browser']}: {item['message']}" for item in errors[:3])
    if detail:
        raise RuntimeError(f"local browser Google auth cookies were not found ({detail})")
    raise RuntimeError("local browser Google auth cookies were not found")


def maybe_import_google_cookies_from_browser(jar):
    disabled = os.environ.get("IMOOCS_DISABLE_BROWSER_COOKIE_IMPORT", "").lower()
    if disabled in ("1", "true", "yes"):
        return {"ok": False, "browser": "", "message": "browser cookie import is disabled"}
    try:
        profile = os.environ.get("IMOOCS_BROWSER_PROFILE", "").strip() or os.environ.get("IMOOCS_CHROME_PROFILE", "").strip()
        info = import_google_cookies_from_browser(jar, os.environ.get("IMOOCS_BROWSER", "auto"), profile)
        try:
            save_cookie_jar(jar)
            info["cookieStore"] = "saved"
        except Exception as exc:
            # The imported cookies are still usable for this process. Report
            # that they were not persisted instead of discarding a valid jar.
            info["cookieStore"] = "not_persisted"
            info["cookieStoreWarning"] = str(exc)[:240]
        return info
    except Exception as exc:
        return {
            "ok": False,
            "browser": os.environ.get("IMOOCS_BROWSER", "auto"),
            "profile": os.environ.get("IMOOCS_BROWSER_PROFILE", "").strip() or os.environ.get("IMOOCS_CHROME_PROFILE", "").strip(),
            "message": str(exc)[:300],
        }


def is_google_authenticated(jar):
    final_url, status, _headers, body = request(jar, "https://docs.google.com/presentation/u/0/", timeout=30)
    parsed = urllib.parse.urlparse(final_url)
    if 200 <= status < 400 and parsed.hostname == "docs.google.com":
        return True

    return False


def follow_google_transitions(jar, final_url, page_html):
    for _ in range(10):
        if is_google_authenticated(jar):
            return True

        form = google_hidden_post_form(page_html, final_url)
        if form:
            action_url, fields = form
            final_url, status, _headers, body = post_form(jar, action_url, fields, final_url)
            if not (200 <= status < 400):
                return False
            page_html = decode_body(body)
            continue

        next_url = meta_refresh_url(page_html, final_url) or javascript_redirect_url(page_html, final_url) or google_continue_url(page_html, final_url)
        if next_url:
            final_url, status, _headers, body = request(jar, next_url, timeout=60)
            if not (200 <= status < 400):
                raise RuntimeError(f"Google continuation returned HTTP {status}")
            page_html = decode_body(body)
            continue

        break

    return is_google_authenticated(jar)


def ensure_google_docs_authenticated(jar):
    if is_google_authenticated(jar):
        return True
    final_url, status, _headers, body = request(jar, "https://docs.google.com/presentation/u/0/", timeout=60)
    if not (200 <= status < 400):
        return False
    return follow_google_transitions(jar, final_url, decode_body(body))


def login_google(jar, username, password):
    final_url, status, _headers, body = request(jar, GOOGLE_SIGN_IN_URL, timeout=60)
    if not (200 <= status < 400):
        raise RuntimeError(f"Google SAML login failed: HTTP {status}")
    page_html = decode_body(body)

    form = google_signin_form(page_html, final_url)
    if form:
        action_url, fields, _attrs, _body = form
        fields["username"] = username
        fields["password"] = password
        final_url, status, _headers, body = post_form(jar, action_url, fields, final_url)
        if not (200 <= status < 400):
            raise RuntimeError(f"Google SAML identity provider returned HTTP {status}")
        page_html = decode_body(body)
        if html_contains_login_error(page_html):
            raise RuntimeError("Google SAML login failed: credentials were rejected or additional verification is required")

    saml_form = named_form(page_html, final_url, "saml-post-binding")
    if not saml_form:
        if follow_google_transitions(jar, final_url, page_html) and ensure_google_docs_authenticated(jar):
            return
        raise RuntimeError("Google SAML login failed: SAML post-binding form was not found")

    action_url, fields, _attrs, _body = saml_form
    required = ("SAMLResponse", "RelayState")
    if not all(fields.get(name) for name in required):
        raise RuntimeError("Google SAML login failed: SAML response fields were not found")
    final_url, status, _headers, body = post_form(
        jar,
        action_url,
        {name: fields[name] for name in required},
        final_url,
    )
    if not (200 <= status < 400):
        raise RuntimeError(f"Google SAML post-binding returned HTTP {status}")
    page_html = decode_body(body)

    if not follow_google_transitions(jar, final_url, page_html):
        raise RuntimeError("Google login did not produce an authenticated session")
    if not ensure_google_docs_authenticated(jar):
        raise RuntimeError("Google login did not produce a Google Docs session")


def auth_login(args):
    use_gui = False
    use_keychain = False
    if args == ["--gui"]:
        use_gui = True
    elif args == ["--keychain"]:
        use_keychain = True
    elif args:
        fail_text("usage: imoocs auth login [--gui|--keychain]", 64)

    username = os.environ.get("IMOOCS_USERNAME", "").strip()
    if not username:
        username = input("ユーザー名: ").strip()
    if use_keychain:
        password = password_from_keychain(username)
        if not password:
            fail_text("password was not found in supported INIAD Keychain items", 69)
    elif use_gui:
        password = password_from_gui()
    else:
        password = getpass.getpass("パスワード: ")
    if not username or not password:
        fail_text("username and password are required", 64)

    jar = http.cookiejar.CookieJar()
    final_url, status, _headers, body = request(jar, SIGN_IN_URL)
    page_html = decode_body(body)
    form = login_form(page_html, final_url)
    if form is None:
        if not looks_like_login_page(page_html, final_url):
            page_html = ""
        else:
            fail_text("login form was not found", 2)
    else:
        action_url, fields = form
        fields["username"] = username
        fields["password"] = password
        fields["login"] = fields.get("login", "LOG IN")
        final_url, status, _headers, body = post_form(jar, action_url, fields, final_url)
        page_html = decode_body(body)
        if not (200 <= status < 400):
            fail_text(f"login failed: HTTP {status}", 2)
        if looks_like_login_page(page_html, final_url):
            fail_text("login failed: credentials were rejected or additional verification is required", 2)

    final_url, status, _headers, body = request(jar, f"{BASE_URL}/courses")
    page_html = decode_body(body)
    if not (200 <= status < 400) or looks_like_login_page(page_html, final_url):
        fail_text("login did not produce an authenticated MOOCs session", 2)

    # Save the MOOCs session before the optional Google Slides session.
    # Assignments only require MOOCs cookies, so a Google-side SAML change
    # should not discard a valid MOOCs login.
    save_cookie_jar(jar)

    # Google Slides cookies are only needed for slide collection. Keep normal
    # login short and reliable for assignment work; opt in when slides require
    # a fresh Google session.
    if os.environ.get("IMOOCS_AUTH_WITH_GOOGLE", "").lower() not in ("1", "true", "yes"):
        print("auth login completed")
        return 0

    try:
        login_google(jar, username, password)
    except Exception as exc:
        print(f"auth login completed for MOOCs; Google session unavailable: {exc}", file=sys.stderr)
        return 0

    save_cookie_jar(jar)
    print("auth login completed")
    return 0


def auth_import_browser(args):
    browser = os.environ.get("IMOOCS_BROWSER", "auto")
    profile = os.environ.get("IMOOCS_BROWSER_PROFILE", "").strip() or os.environ.get("IMOOCS_CHROME_PROFILE", "").strip()
    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg in ("-h", "--help"):
            print("""Usage:
  imoocs auth import-browser [--browser auto|chrome|chromium|brave|edge|firefox] [--profile <chrome-profile>]

Imports an existing local browser Google session into the imoocs CLI cookie jar.
When no profile is provided, INIAD-looking Chrome profiles are tried first.
Cookie values are never printed.
""".rstrip())
            return 0
        if arg == "--browser":
            idx += 1
            if idx >= len(args):
                fail_text("--browser requires a value", 64)
            browser = args[idx]
            idx += 1
            continue
        if arg == "--profile":
            idx += 1
            if idx >= len(args):
                fail_text("--profile requires a value", 64)
            profile = args[idx]
            idx += 1
            continue
        if not arg.startswith("-") and browser == os.environ.get("IMOOCS_BROWSER", "auto"):
            browser = arg
            idx += 1
            continue
        fail_text(f"unknown argument for auth import-browser: {arg}", 64)

    jar, store_status = load_cookie_jar()
    if store_status in ("missing_keyring", "keyring_unavailable"):
        fail_text("auth keyring is unavailable", 69)

    info = import_google_cookies_from_browser(jar, browser, profile)
    save_cookie_jar(jar)
    names = ", ".join(info["authCookieNames"])
    tried = ", ".join(info["triedBrowsers"])
    profile_text = f" profile={info['profile']}" if info.get("profile") else ""
    print(
        "auth import-browser completed: "
        f"browser={info['browser']}{profile_text} tried={tried} "
        f"googleCookies={info['importedCookieCount']} authCookies={names}"
    )
    return 0


def auth_status():
    jar, store_status = load_cookie_jar()
    if store_status == "loaded" and any(True for _ in jar):
        if ensure_moocs_authenticated(jar):
            try:
                save_cookie_jar(jar)
            except Exception:
                pass
            print("auth session is usable")
        else:
            print("auth session cookies are stored but expired")
            return 2
    elif store_status in ("missing_keyring", "keyring_unavailable"):
        print("auth keyring is unavailable")
        return 1
    else:
        print("auth session cookies are not stored")
    return 0


def auth_logout():
    delete_cookie_jar()
    print("auth session cookies were removed from the keyring")
    return 0


