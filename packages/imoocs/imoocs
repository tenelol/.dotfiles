set -uo pipefail

backend="imoocs-native"

usage() {
  cat <<'EOF'
Usage:
  imoocs open <moocs-url>
  imoocs slide collect --path <dir> --year <year>
  imoocs drive ls [--parent <drive-folder-url-or-id>] [--recursive] [--match <text>]
  imoocs drive collect --path <dir> [--parent <drive-folder-url-or-id>] [--recursive] [--match <text>]
  imoocs course|lesson <action> [args...]
  imoocs assignment show <moocs-url>
  imoocs assignment submit <courseId> <problemId> --data <json|@file>
  imoocs assignment upload <courseId> <problemId> --pid <pid> <file>
  imoocs assignment submit --confirm --course-id <id> --problem-id <id> [--file <path>] [--text <text>]
  imoocs assignment upload --confirm --course-id <id> --problem-id <id> --file <path>
  imoocs assignment push <courseId> <problemId>
  imoocs auth status
  imoocs auth login [--gui|--keychain]
  imoocs auth import-browser [--browser auto|chrome|chromium|brave|edge|firefox] [--profile <chrome-profile>]
  imoocs auth logout
  imoocs reset

Notes:
  course, lesson, assignment, slide, drive, and open print JSON envelopes.
  auth and reset print text and use the exit code for status.
  slide collect uses the stored imoocs auth session and can import local browser Google cookies.
  drive commands use the stored Google cookies and default to the configured INIAD 2026 parent folder.
  In non-interactive shells, pass --course/--lecture/--page or explicit --all.
EOF
}

json_envelope() {
  local ok="$1"
  local kind="$2"
  local action="$3"
  local status="$4"
  local code="$5"
  local message="$6"
  local submission_state="${7:-none}"
  local data_json="${8:-}"

  if [[ -z "$data_json" ]]; then
    data_json="{}"
  fi

  OK="$ok" \
    KIND="$kind" \
    ACTION="$action" \
    STATUS="$status" \
    CODE="$code" \
    MESSAGE="$message" \
    SUBMISSION_STATE="$submission_state" \
    BACKEND="$backend" \
    DATA_JSON="$data_json" \
    python3 - <<'PY'
import json
import os
import sys

try:
    data = json.loads(os.environ.get("DATA_JSON", "{}"))
except json.JSONDecodeError as exc:
    print(f"invalid DATA_JSON: {exc}", file=sys.stderr)
    sys.exit(70)

payload = {
    "ok": os.environ["OK"] == "true",
    "kind": os.environ["KIND"],
    "action": os.environ["ACTION"],
    "backend": os.environ["BACKEND"],
    "status": os.environ["STATUS"],
    "data": data,
    "submission": {"state": os.environ["SUBMISSION_STATE"]},
}

code = os.environ.get("CODE", "")
message = os.environ.get("MESSAGE", "")
if code or message:
    payload["error"] = {
        "code": code or "error",
        "message": message,
    }

print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))
PY
}

simple_unsupported() {
  local kind="$1"
  local action="${2:-unknown}"
  local data_json="${3:-}"

  if [[ -z "$data_json" ]]; then
    data_json="{}"
  fi

  json_envelope \
    false \
    "$kind" \
    "$action" \
    "unsupported" \
    "unsupported_by_imoocs" \
    "imoocs does not provide this operation; no browser fallback or manual URL parsing was performed." \
    "none" \
    "$data_json"
}

