diff --git a/azooKeyMac/InputController/Effects/DopamineCandidateDecoration.swift b/azooKeyMac/InputController/Effects/DopamineCandidateDecoration.swift
new file mode 100644
index 0000000..317ce23
--- /dev/null
+++ b/azooKeyMac/InputController/Effects/DopamineCandidateDecoration.swift
@@ -0,0 +1,246 @@
+import AppKit
+import QuartzCore
+
+/// 候補ウィンドウの縁を流れるネオン枠と、選択行へ滑って移動するハイライト
+@MainActor
+final class DopamineCandidateDecoration: CandidateDecoration {
+    private static let cornerRadius: CGFloat = 16
+    private static let borderColors: [NSColor] = [
+        .effectHex(0xFF4D6D), .effectHex(0xFFE45C), .effectHex(0x5CFF8F),
+        .effectHex(0x5CF2FF), .effectHex(0xB45CFF), .effectHex(0xFF4D6D)
+    ]
+    private static let selectionColors: [NSColor] = [.effectHex(0xFF4D9D), .effectHex(0xB45CFF), .effectHex(0x5C8BFF)]
+
+    private let borderContainer = CALayer()
+    private let borderGradient = CAGradientLayer()
+    private let borderMask = CAShapeLayer()
+    private let selection = CAGradientLayer()
+    private let sheen = CAGradientLayer()
+    private var selectionVisible = false
+    private var lastScrollOffset: CGFloat = 0
+    private weak var tableView: NSTableView?
+
+    func install(in container: NSView, tableView: NSTableView) {
+        container.wantsLayer = true
+        tableView.wantsLayer = true
+        self.tableView = tableView
+
+        // 枠は回転する円錐グラデーションを細い角丸の線で切り抜いて作る
+        self.borderGradient.type = .conic
+        self.borderGradient.colors = Self.borderColors.map(\.cgColor)
+        self.borderGradient.startPoint = CGPoint(x: 0.5, y: 0.5)
+        self.borderGradient.endPoint = CGPoint(x: 0.5, y: 0)
+        self.borderMask.fillColor = nil
+        self.borderMask.strokeColor = NSColor.white.cgColor
+        self.borderMask.lineWidth = 2.5
+        self.borderContainer.mask = self.borderMask
+        self.borderContainer.addSublayer(self.borderGradient)
+        self.borderContainer.zPosition = 100
+
+        self.selection.colors = Self.selectionColors.map(\.cgColor)
+        self.selection.startPoint = CGPoint(x: 0, y: 0.5)
+        self.selection.endPoint = CGPoint(x: 1, y: 0.5)
+        self.selection.cornerRadius = 9
+        self.selection.shadowColor = Self.selectionColors[0].cgColor
+        self.selection.shadowOffset = .zero
+        self.selection.shadowRadius = 8
+        self.selection.shadowOpacity = 0.9
+        self.selection.opacity = 0
+        self.selection.masksToBounds = false
+
+        // 選択が動くたびに左から右へ走る光沢
+        self.sheen.colors = [NSColor.white.withAlphaComponent(0).cgColor, NSColor.white.withAlphaComponent(0.55).cgColor, NSColor.white.withAlphaComponent(0).cgColor]
+        self.sheen.startPoint = CGPoint(x: 0, y: 0.5)
+        self.sheen.endPoint = CGPoint(x: 1, y: 0.5)
+        self.sheen.opacity = 0
+        let sheenClip = CALayer()
+        sheenClip.masksToBounds = true
+        sheenClip.cornerRadius = 9
+        sheenClip.frame = .zero
+        sheenClip.name = "sheenClip"
+        sheenClip.addSublayer(self.sheen)
+        self.selection.addSublayer(sheenClip)
+
+        container.layer?.addSublayer(self.borderContainer)
+        tableView.layer?.insertSublayer(self.selection, at: 0)
+
+        let spin = CABasicAnimation(keyPath: "transform.rotation.z")
+        spin.fromValue = 0
+        spin.toValue = -2 * CGFloat.pi
+        spin.duration = 3
+        spin.repeatCount = .infinity
+        self.borderGradient.add(spin, forKey: "spin")
+    }
+
+    func uninstall() {
+        self.borderContainer.removeFromSuperlayer()
+        self.selection.removeFromSuperlayer()
+    }
+
+    func layout(in bounds: CGRect) {
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.borderContainer.frame = bounds
+        self.borderMask.frame = bounds
+        let inset = self.borderMask.lineWidth / 2
+        self.borderMask.path = CGPath(
+            roundedRect: bounds.insetBy(dx: inset, dy: inset),
+            cornerWidth: Self.cornerRadius - inset,
+            cornerHeight: Self.cornerRadius - inset,
+            transform: nil
+        )
+        // 回転しても四隅が欠けないよう、対角線長の正方形にして中央に置く
+        let side = hypot(bounds.width, bounds.height)
+        self.borderGradient.bounds = CGRect(x: 0, y: 0, width: side, height: side)
+        self.borderGradient.position = CGPoint(x: bounds.midX, y: bounds.midY)
+        CATransaction.commit()
+    }
+
+    func moveSelection(toRow row: Int?) {
+        guard let row, let tableView = self.tableView, let target = tableView.effectRect(ofRow: row, inset: CGSize(width: 5, height: 2)) else {
+            self.selection.opacity = 0
+            self.selectionVisible = false
+            return
+        }
+        // 選択に合わせて一覧がスクロールした分だけ開始位置をずらし、見た目の位置から動かす
+        let scrollOffset = tableView.effectScrollOffset
+        var previous = self.selection.presentation()?.frame ?? self.selection.frame
+        previous.origin.y += scrollOffset - self.lastScrollOffset
+        self.lastScrollOffset = scrollOffset
+
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.selection.frame = target
+        if let clip = self.selection.sublayers?.first(where: { $0.name == "sheenClip" }) {
+            clip.frame = self.selection.bounds
+            self.sheen.frame = CGRect(x: -target.width * 0.4, y: 0, width: target.width * 0.4, height: target.height)
+        }
+        self.selection.opacity = 1
+        CATransaction.commit()
+
+        if !self.selectionVisible {
+            let pop = CAKeyframeAnimation(keyPath: "transform.scale")
+            pop.values = [0.85, 1.04, 1]
+            pop.duration = 0.25
+            self.selection.add(pop, forKey: "pop")
+        } else if previous != target {
+            let move = CASpringAnimation(keyPath: "position")
+            move.fromValue = NSValue(point: CGPoint(x: previous.midX, y: previous.midY))
+            move.toValue = NSValue(point: CGPoint(x: target.midX, y: target.midY))
+            move.damping = 18
+            move.stiffness = 420
+            move.duration = move.settlingDuration
+            self.selection.add(move, forKey: "move")
+
+            let size = CASpringAnimation(keyPath: "bounds.size")
+            size.fromValue = NSValue(size: previous.size)
+            size.toValue = NSValue(size: target.size)
+            size.damping = 18
+            size.stiffness = 420
+            size.duration = size.settlingDuration
+            self.selection.add(size, forKey: "size")
+        }
+
+        let sweep = CABasicAnimation(keyPath: "position.x")
+        sweep.fromValue = -target.width * 0.2
+        sweep.toValue = target.width * 1.2
+        sweep.duration = 0.45
+        sweep.timingFunction = CAMediaTimingFunction(name: .easeOut)
+        let sheenOpacity = CAKeyframeAnimation(keyPath: "opacity")
+        sheenOpacity.values = [0, 1, 0]
+        sheenOpacity.duration = 0.45
+        self.sheen.add(sweep, forKey: "sweep")
+        self.sheen.add(sheenOpacity, forKey: "sheenOpacity")
+        self.emitSparkles(around: target, in: tableView)
+        self.selectionVisible = true
+    }
+
+    /// 選択が着いた行の縁から星を弾けさせる
+    private func emitSparkles(around rect: CGRect, in tableView: NSTableView) {
+        guard let star = Self.sparkleImage else {
+            return
+        }
+        let emitter = CAEmitterLayer()
+        emitter.frame = tableView.bounds
+        emitter.emitterShape = .rectangle
+        emitter.emitterMode = .outline
+        emitter.emitterPosition = CGPoint(x: rect.midX, y: rect.midY)
+        emitter.emitterSize = rect.size
+        emitter.renderMode = .additive
+        emitter.beginTime = CACurrentMediaTime()
+        emitter.emitterCells = Self.selectionColors.map { color in
+            let cell = CAEmitterCell()
+            cell.contents = star
+            cell.color = color.cgColor
+            cell.birthRate = 160
+            cell.lifetime = 0.6
+            cell.velocity = 50
+            cell.velocityRange = 30
+            cell.emissionRange = .pi * 2
+            cell.scale = 0.35
+            cell.scaleRange = 0.2
+            cell.scaleSpeed = -0.4
+            cell.alphaSpeed = -1.6
+            cell.spin = 3
+            return cell
+        }
+        tableView.layer?.addSublayer(emitter)
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.08) {
+            emitter.birthRate = 0
+        }
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.9) {
+            emitter.removeFromSuperlayer()
+        }
+    }
+
+    /// 4方向に尖ったきらめき（白で描いて粒子ごとに色を付ける）
+    private static let sparkleImage: CGImage? = {
+        let size = 32
+        guard let context = CGContext(
+            data: nil,
+            width: size,
+            height: size,
+            bitsPerComponent: 8,
+            bytesPerRow: 0,
+            space: CGColorSpace(name: CGColorSpace.sRGB) ?? CGColorSpaceCreateDeviceRGB(),
+            bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
+        ) else {
+            return nil
+        }
+        let path = CGMutablePath()
+        for index in 0..<8 {
+            let angle = CGFloat(index) * .pi / 4
+            let radius: CGFloat = index.isMultiple(of: 2) ? 16 : 4
+            let point = CGPoint(x: 16 + cos(angle) * radius, y: 16 + sin(angle) * radius)
+            if index == 0 {
+                path.move(to: point)
+            } else {
+                path.addLine(to: point)
+            }
+        }
+        path.closeSubpath()
+        context.addPath(path)
+        context.setFillColor(NSColor.white.cgColor)
+        context.fillPath()
+        return context.makeImage()
+    }()
+
+    /// ウィンドウが表示されたときに下から浮き上がらせる
+    func playAppear(on layer: CALayer?) {
+        guard let layer else {
+            return
+        }
+        let fade = CABasicAnimation(keyPath: "opacity")
+        fade.fromValue = 0
+        fade.toValue = 1
+        let rise = CASpringAnimation(keyPath: "transform.translation.y")
+        rise.fromValue = -10
+        rise.toValue = 0
+        rise.damping = 14
+        rise.stiffness = 380
+        let group = CAAnimationGroup()
+        group.animations = [fade, rise]
+        group.duration = rise.settlingDuration
+        layer.add(group, forKey: "appear")
+    }
+}
diff --git a/azooKeyMac/InputController/Effects/DopamineEffectTheme.swift b/azooKeyMac/InputController/Effects/DopamineEffectTheme.swift
new file mode 100644
index 0000000..5b18ebc
--- /dev/null
+++ b/azooKeyMac/InputController/Effects/DopamineEffectTheme.swift
@@ -0,0 +1,971 @@
+import AppKit
+import CoreText
+import QuartzCore
+
+/// コンボ数・ランク・キーワードで派手に盛り上げる演出。
+/// IMKInputController はクライアントごとに生成されるため、コンボ状態はテーマ側で保持する。
+@MainActor
+final class DopamineEffectTheme: EffectTheme {
+    let id = "dopamine"
+    let title = "ドーパミン"
+
+    private struct Rank {
+        var letter: String
+        var colors: [NSColor]
+    }
+
+    private struct KeywordEffect {
+        var keywords: [String]
+        var title: String
+        var colors: [NSColor]
+        var emoji: [String]
+        var tint: NSColor?
+        var rockets: Bool = false
+    }
+
+    private static let comboTimeout: TimeInterval = 3.0
+    private static let keywordBufferLength = 32
+
+    private static let keywordEffects: [KeywordEffect] = [
+        .init(
+            keywords: ["リリース", "release", "ship", "デプロイ", "deploy", "完成", "マージ", "merge", "公開"],
+            title: "SHIPPED!",
+            colors: [.effectHex(0xB45CFF), .effectHex(0x5CF2FF), .effectHex(0x5CFF8F)],
+            emoji: ["🚀", "✨"],
+            tint: nil,
+            rockets: true
+        ),
+        .init(
+            keywords: ["好き", "すき", "愛", "love", "かわいい", "可愛い"],
+            title: "LOVE",
+            colors: [.effectHex(0xFF4D6D), .effectHex(0xFF9ECF), .effectHex(0xFFD1E8)],
+            emoji: ["💖", "💕", "😍"],
+            tint: .effectHex(0xFF2D6F)
+        ),
+        .init(
+            keywords: ["最強", "天才", "完璧", "最高", "critical"],
+            title: "CRITICAL!!",
+            colors: [.effectHex(0xFFE45C), .effectHex(0xFF9F1C), .effectHex(0xFF4D6D)],
+            emoji: ["💎", "✨", "⭐️"],
+            tint: .effectHex(0xFFB020)
+        ),
+        .init(
+            keywords: ["ドーパミン", "ドパ", "やばい", "ヤバい", "すごい", "凄い"],
+            title: "MEGA HIT",
+            colors: [.effectHex(0x5CF2FF), .effectHex(0x8F7BFF), .effectHex(0xFF5CF2)],
+            emoji: ["⚡️", "🔥", "💥"],
+            tint: .effectHex(0x7B5CFF)
+        ),
+        .init(
+            keywords: ["ありがとう", "感謝", "thanks", "thank you"],
+            title: "THANKS!!",
+            colors: [.effectHex(0x5CFF8F), .effectHex(0xFFE45C)],
+            emoji: ["🙏", "🌸", "🎉"],
+            tint: nil
+        ),
+        .init(
+            keywords: ["バグ", "bug", "エラー", "error"],
+            title: "BUG?!",
+            colors: [.effectHex(0xA3FF5C), .effectHex(0x2EC27E)],
+            emoji: ["🐛", "💥", "🪲"],
+            tint: .effectHex(0x2EC27E)
+        )
+    ]
+
+    private var comboLayer: CALayer?
+    private var comboTimerLayer: CALayer?
+    private var combo = 0
+    private var resetWorkItem: DispatchWorkItem?
+    private var recentCommittedText = ""
+    /// 30コンボ以上で出し続ける虹色の縁と紙吹雪の雨
+    private var feverLayers: [CALayer] = []
+    private var imageCache: [String: CGImage] = [:]
+
+    // MARK: - EffectTheme
+
+    func keystroke(at caret: CGRect) {
+        guard let (root, local) = self.prepareRoot(for: caret) else {
+            return
+        }
+        self.combo += 1
+        let rank = Self.rank(for: self.combo)
+
+        self.emitSparks(at: local, colors: rank.colors, intensity: min(1 + CGFloat(self.combo) / 25, 3), in: root)
+        self.emitSpeedLines(at: local, color: rank.colors[0], in: root)
+        self.pulseRing(at: local, color: rank.colors[rank.colors.count - 1], in: root)
+        // コンボが伸びるほど絵文字が飛び出しやすくなる
+        if Double.random(in: 0..<1) < min(0.25 + Double(self.combo) / 100, 0.7) {
+            self.popEmoji(Self.keystrokeEmoji(for: rank).randomElement() ?? "✨", at: local, in: root)
+        }
+        if self.combo >= 30 {
+            self.startFever(in: root)
+        }
+        if self.combo % 10 == 0 {
+            self.showMilestone(rank: rank, in: root)
+        }
+        self.showComboLabel(rank: rank, near: local, in: root)
+        self.scheduleComboReset()
+    }
+
+    /// キーワードを含む確定文字列には専用の演出を出す
+    func commit(_ text: String, at caret: CGRect) {
+        guard let (root, local) = self.prepareRoot(for: caret) else {
+            return
+        }
+        // 英字入力は1文字ずつ確定されるため、直近の確定文字列をまとめてキーワード判定する
+        self.recentCommittedText = String((self.recentCommittedText + text).suffix(Self.keywordBufferLength))
+        let haystack = self.recentCommittedText.lowercased()
+        if let effect = Self.keywordEffects.first(where: { $0.keywords.contains(where: haystack.contains) }) {
+            self.recentCommittedText = ""
+            self.playKeywordEffect(effect, near: local, in: root)
+        } else if text.count >= 2 {
+            let praise = Self.praise(forLength: text.count)
+            self.emitStarShower(at: local, in: root)
+            if text.count >= 8 {
+                for index in 0..<3 {
+                    let point = CGPoint(x: local.x + CGFloat.random(in: -160...160), y: local.y + CGFloat.random(in: 40...160))
+                    self.fireworks(at: point, colors: praise.colors, delay: Double(index) * 0.12, in: root)
+                }
+            }
+            self.showFloatingText(praise.text, colors: praise.colors, fontSize: praise.fontSize, at: local, in: root)
+        }
+    }
+
+    /// 確定した長さで褒め言葉と大きさを上げる
+    private struct Praise {
+        var text: String
+        var fontSize: CGFloat
+        var colors: [NSColor]
+    }
+
+    private static func praise(forLength length: Int) -> Praise {
+        switch length {
+        case 12...:
+            Praise(text: "PERFECT!!!", fontSize: 46, colors: [.effectHex(0xFFE45C), .effectHex(0xFF4D6D), .effectHex(0xB45CFF), .effectHex(0x5CF2FF)])
+        case 8...:
+            Praise(text: "EXCELLENT!!", fontSize: 38, colors: [.effectHex(0xFF9F1C), .effectHex(0xFF4D6D), .effectHex(0xFFE45C)])
+        case 5...:
+            Praise(text: "GREAT!", fontSize: 30, colors: [.effectHex(0x5CFF8F), .effectHex(0xFFE45C)])
+        default:
+            Praise(text: "NICE!", fontSize: 24, colors: [.effectHex(0x5CF2FF), .effectHex(0xFFFFFF)])
+        }
+    }
+
+    private static func keystrokeEmoji(for rank: Rank) -> [String] {
+        switch rank.letter {
+        case "C": ["✨", "💫"]
+        case "B": ["⚡️", "✨", "💥"]
+        case "A": ["🔥", "💥", "⚡️", "😎"]
+        default: ["🔥", "🌈", "💎", "🚀", "👑", "🤯"]
+        }
