#!/bin/bash

SKETCHYBAR_BIN="/opt/homebrew/bin/sketchybar"
YABAI_BIN="/run/current-system/sw/bin/yabai"
PLUGIN_DIR="$CONFIG_DIR/plugins"

space_key_code() {
  case "$1" in
    1) printf 18 ;;
    2) printf 19 ;;
    3) printf 20 ;;
    4) printf 21 ;;
    5) printf 23 ;;
    6) printf 22 ;;
    7) printf 26 ;;
    8) printf 28 ;;
    9) printf 25 ;;
  esac
}

bar=(
  position=top
  display=all
  height=42
  margin=0
  y_offset=0
  corner_radius=0
  blur_radius=36
  color=0xd814171d
  border_width=0
  border_color=0x18ffffff
  padding_left=14
  padding_right=14
  sticky=on
  topmost=window
  shadow=off
  font_smoothing=on
)
"$SKETCHYBAR_BIN" --bar "${bar[@]}"

default=(
  updates=when_shown
  drawing=on
  icon.drawing=off
  label.color=0xd8f5f7fa
  label.highlight_color=0xffffffff
  label.font="CaskaydiaCove Nerd Font:Regular:12.0"
  label.padding_left=8
  label.padding_right=8
  background.drawing=off
  background.height=24
  background.corner_radius=12
  background.color=0x00000000
  background.border_width=0
  background.border_color=0x00000000
  blur_radius=0
  padding_left=2
  padding_right=2
)
"$SKETCHYBAR_BIN" --default "${default[@]}"

"$SKETCHYBAR_BIN" --add event yabai_space_change

for sid in 1 2 3 4 5 6 7 8 9; do
  key_code="$(space_key_code "$sid")"
  item=(
    width=18
    padding_left=3
    padding_right=3
    label="$sid"
    label.width=18
    label.align=center
    label.color=0xaef5f7fa
    label.padding_left=0
    label.padding_right=0
    background.drawing=on
    background.height=2
    background.corner_radius=2
    background.padding_left=0
    background.padding_right=0
    background.color=0x00000000
    background.border_color=0x00000000
    background.y_offset=-11
    script="$PLUGIN_DIR/workspace.sh"
    click_script="osascript -e 'tell application \"System Events\" to key code $key_code using control down'"
  )

  "$SKETCHYBAR_BIN" --add item "space.$sid" left \
                    --set "space.$sid" "${item[@]}" \
                    --subscribe "space.$sid" yabai_space_change mouse.entered mouse.exited
done

front_app=(
  width=180
  label.max_chars=20
  label.align=left
  label.color=0xcff5f7fa
  label.font="CaskaydiaCove Nerd Font:SemiBold:12.0"
  background.drawing=off
  script="$PLUGIN_DIR/front_app.sh"
)
"$SKETCHYBAR_BIN" --add item front_app left \
                  --set front_app "${front_app[@]}" \
                  --subscribe front_app front_app_switched

battery=(
  update_freq=60
  background.drawing=off
  background.height=24
  background.corner_radius=12
  background.border_width=1
  label.padding_left=0
  script="$PLUGIN_DIR/battery.sh"
)
"$SKETCHYBAR_BIN" --add item battery right \
                  --set battery "${battery[@]}" \
                  --subscribe battery power_source_change system_woke

clock=(
  update_freq=30
  background.drawing=off
  label.color=0xd8f5f7fa
  label.padding_left=0
  script="$PLUGIN_DIR/clock.sh"
)
"$SKETCHYBAR_BIN" --add item clock right \
                  --set clock "${clock[@]}"

"$SKETCHYBAR_BIN" --update

focused_workspace="$(
  "$YABAI_BIN" -m query --spaces --space 2>/dev/null \
    | sed -nE 's/.*"index"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' \
    | head -n 1
)"

if [ -n "$focused_workspace" ]; then
  "$SKETCHYBAR_BIN" --trigger yabai_space_change FOCUSED="$focused_workspace"
else
  "$SKETCHYBAR_BIN" --trigger yabai_space_change
fi
