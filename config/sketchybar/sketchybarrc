#!/bin/bash

SKETCHYBAR_BIN="/opt/homebrew/bin/sketchybar"
YABAI_BIN="/run/current-system/sw/bin/yabai"
PLUGIN_DIR="$CONFIG_DIR/plugins"

TRANSPARENT=0x00000000
GLASS_BG=0x260b1018
GLASS_BORDER=0x30ffffff
TEXT=0xeef5f7fa
TEXT_DIM=0xa8f5f7fa
TEXT_MUTED=0xcff5f7fa
TEXT_STRONG=0xffffffff

space_click_script() {
  printf "%s" "/opt/homebrew/bin/hs -q -c 'yabaiFocusSpace($1)'"
}

display_space_rows="$(
  "$YABAI_BIN" -m query --displays 2>/dev/null \
    | /usr/bin/python3 -c '
import json
import sys

try:
    displays = json.load(sys.stdin)
except Exception:
    displays = []

for display in sorted(displays, key=lambda item: item.get("index", 0)):
    display_index = display.get("index")
    if not isinstance(display_index, int):
        continue
    for space_index in display.get("spaces", []):
        if isinstance(space_index, int):
            print(f"{display_index} {space_index}")
'
)"

if [ -z "$display_space_rows" ]; then
  display_space_rows="$(
    for sid in 1 2 3 4 5 6 7 8 9; do
      printf '0 %s\n' "$sid"
    done
  )"
fi

bar=(
  position=top
  display=all
  height=42
  margin=0
  y_offset=0
  corner_radius=0
  blur_radius=56
  color="$TRANSPARENT"
  border_width=0
  border_color="$TRANSPARENT"
  padding_left=12
  padding_right=12
  sticky=on
  topmost=window
  shadow=off
  font_smoothing=on
)
"$SKETCHYBAR_BIN" --bar "${bar[@]}"

default=(
  updates=when_shown
  drawing=on
  icon.drawing=off
  label.color="$TEXT"
  label.highlight_color="$TEXT_STRONG"
  label.font="CaskaydiaCove Nerd Font:Regular:12.0"
  label.padding_left=10
  label.padding_right=10
  background.drawing=on
  background.height=28
  background.corner_radius=14
  background.color="$GLASS_BG"
  background.border_width=1
  background.border_color="$GLASS_BORDER"
  blur_radius=0
  padding_left=3
  padding_right=3
)
"$SKETCHYBAR_BIN" --default "${default[@]}"

while read -r did sid; do
  [ -n "$did" ] && [ -n "$sid" ] || continue
  click_script="$(space_click_script "$sid")"
  item=(
    width=18
    padding_left=3
    padding_right=3
    label="$sid"
    label.width=18
    label.align=center
    label.color="$TEXT_DIM"
    label.padding_left=0
    label.padding_right=0
    background.drawing=on
    background.height=3
    background.corner_radius=2
    background.padding_left=0
    background.padding_right=0
    background.color="$TRANSPARENT"
    background.border_color="$TRANSPARENT"
    background.y_offset=-11
    space="$sid"
    script="$PLUGIN_DIR/workspace.sh"
    click_script="$click_script"
  )

  if [ "$did" != 0 ]; then
    item+=(display="$did")
  fi

  "$SKETCHYBAR_BIN" --add space "space.$sid" left \
                    --set "space.$sid" "${item[@]}" \
                    --subscribe "space.$sid" mouse.entered mouse.exited
done <<EOF
$display_space_rows
EOF

spaces=(
  background.drawing=on
  background.height=28
  background.corner_radius=14
  background.color="$GLASS_BG"
  background.border_width=1
  background.border_color="$GLASS_BORDER"
  background.padding_left=6
  background.padding_right=6
)

for did in $(printf '%s\n' "$display_space_rows" | /usr/bin/awk '{ print $1 }' | /usr/bin/sort -n | /usr/bin/uniq); do
  bracket_members=()

  while read -r row_did sid; do
    [ "$row_did" = "$did" ] || continue
    bracket_members+=("space.$sid")
  done <<EOF
$display_space_rows
EOF

  [ "${#bracket_members[@]}" -gt 0 ] || continue

  bracket_name="spaces.$did"
  "$SKETCHYBAR_BIN" --add bracket "$bracket_name" "${bracket_members[@]}" \
                    --set "$bracket_name" "${spaces[@]}"
done

front_app=(
  width=190
  label.max_chars=24
  label.align=left
  label.color="$TEXT_MUTED"
  label.font="CaskaydiaCove Nerd Font:SemiBold:12.0"
  background.drawing=on
  background.color="$GLASS_BG"
  background.border_color="$GLASS_BORDER"
  script="$PLUGIN_DIR/front_app.sh"
)
"$SKETCHYBAR_BIN" --add item front_app left \
                  --set front_app "${front_app[@]}" \
                  --subscribe front_app front_app_switched

battery=(
  update_freq=60
  background.drawing=on
  background.height=28
  background.corner_radius=14
  background.color="$GLASS_BG"
  background.border_color="$GLASS_BORDER"
  background.border_width=1
  label.padding_left=0
  script="$PLUGIN_DIR/battery.sh"
)
"$SKETCHYBAR_BIN" --add item battery right \
                  --set battery "${battery[@]}" \
                  --subscribe battery power_source_change system_woke

clock=(
  update_freq=30
  background.drawing=on
  background.color="$GLASS_BG"
  background.border_color="$GLASS_BORDER"
  label.color="$TEXT"
  label.padding_left=10
  label.padding_right=10
  script="$PLUGIN_DIR/clock.sh"
)
"$SKETCHYBAR_BIN" --add item clock right \
                  --set clock "${clock[@]}"

"$SKETCHYBAR_BIN" --update

"$YABAI_BIN" -m query --spaces 2>/dev/null \
  | /usr/bin/python3 -c '
import json
import sys

try:
    spaces = json.load(sys.stdin)
except Exception:
    spaces = []

for space in spaces:
    space_index = space.get("index")
    if isinstance(space_index, int):
        selected = "true" if space.get("is-visible") else "false"
        print(f"{space_index} {selected}")
' \
  | while read -r sid selected; do
    NAME="space.$sid" SID="$sid" SELECTED="$selected" SENDER=forced "$PLUGIN_DIR/workspace.sh"
  done
