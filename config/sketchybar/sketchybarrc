#!/bin/bash

SKETCHYBAR_BIN="/opt/homebrew/bin/sketchybar"
RIFT_CLI="/opt/homebrew/bin/rift-cli"
PLUGIN_DIR="$CONFIG_DIR/plugins"

TRANSPARENT=0x00000000
GLASS_BG=0x260b1018
GLASS_BORDER=0x30ffffff
TEXT=0xeef5f7fa
TEXT_DIM=0xa8f5f7fa
TEXT_MUTED=0xcff5f7fa
TEXT_STRONG=0xffffffff
ACCENT=0xff8bd5ff

theme_file="${XDG_CONFIG_HOME:-$HOME/.config}/theme/sketchybar.env"
[ -r "$theme_file" ] && . "$theme_file"

focused_workspace() {
  if /usr/bin/pgrep -qx AeroSpace >/dev/null 2>&1 && [ -x /opt/homebrew/bin/aerospace ]; then
    /opt/homebrew/bin/aerospace list-workspaces --focused 2>/dev/null | head -n 1
    return
  fi

  "$RIFT_CLI" query workspaces 2>/dev/null \
    | tr '{' '\n' \
    | sed -nE 's/.*"index"[[:space:]]*:[[:space:]]*([0-9]+).*"is_active"[[:space:]]*:[[:space:]]*true.*/\1/p' \
    | head -n 1 \
    | awk '{ print $1 + 1 }'
}

add_workspace_item() {
  local workspace_id="$1"
  local local_workspace="$2"
  local display_id="${3:-}"
  local item_name="space.$workspace_id.$local_workspace"
  local workspace_index=$((local_workspace - 1))
  local display_arg=()

  if [ -n "$display_id" ]; then
    display_arg=(display="$display_id")
  fi

  item=(
    "${display_arg[@]}"
    width=18
    padding_left=3
    padding_right=3
    label="$local_workspace"
    label.width=18
    label.align=center
    label.color="$TEXT_DIM"
    label.padding_left=0
    label.padding_right=0
    background.drawing=on
    background.height=3
    background.corner_radius=2
    background.padding_left=0
    background.padding_right=0
    background.color="$TRANSPARENT"
    background.border_color="$TRANSPARENT"
    background.y_offset=-11
    script="$PLUGIN_DIR/workspace.sh"
    click_script="/bin/sh -lc 'if /usr/bin/pgrep -qx AeroSpace && [ -x /opt/homebrew/bin/aerospace ]; then /opt/homebrew/bin/aerospace workspace $workspace_id; else /opt/homebrew/bin/rift-cli execute workspace switch $workspace_index; fi'"
  )

  "$SKETCHYBAR_BIN" --add item "$item_name" left \
                    --set "$item_name" "${item[@]}" \
                    --subscribe "$item_name" mouse.entered mouse.exited
}

add_workspace_group() {
  local group_name="$1"
  local display_id="${2:-}"
  local offset="$3"
  local bracket_display_arg=()
  local item_names=()
  local workspace_id

  if [ -n "$display_id" ]; then
    bracket_display_arg=(display="$display_id")
  fi

  for local_workspace in 1 2 3 4 5; do
    workspace_id="$((offset + local_workspace))"
    item_names+=("space.$workspace_id.$local_workspace")
    add_workspace_item "$workspace_id" "$local_workspace" "$display_id"
  done

  "$SKETCHYBAR_BIN" --add bracket "spaces.$group_name" "${item_names[@]}" \
                    --set "spaces.$group_name" "${bracket_display_arg[@]}" "${spaces[@]}"
}

bar=(
  position=top
  display=all
  height=42
  margin=0
  y_offset=0
  corner_radius=0
  blur_radius=56
  color="$TRANSPARENT"
  border_width=0
  border_color="$TRANSPARENT"
  padding_left=12
  padding_right=12
  sticky=on
  topmost=window
  shadow=off
  font_smoothing=on
)
"$SKETCHYBAR_BIN" --bar "${bar[@]}"

default=(
  updates=when_shown
  drawing=on
  icon.drawing=off
  label.color="$TEXT"
  label.highlight_color="$TEXT_STRONG"
  label.font="CaskaydiaCove Nerd Font:Regular:12.0"
  label.padding_left=10
  label.padding_right=10
  background.drawing=on
  background.height=28
  background.corner_radius=14
  background.color="$GLASS_BG"
  background.border_width=1
  background.border_color="$GLASS_BORDER"
  blur_radius=0
  padding_left=3
  padding_right=3
)
"$SKETCHYBAR_BIN" --default "${default[@]}"

"$SKETCHYBAR_BIN" --add event workspace_change

spaces=(
  background.drawing=on
  background.height=28
  background.corner_radius=14
  background.color="$GLASS_BG"
  background.border_width=1
  background.border_color="$GLASS_BORDER"
  background.padding_left=6
  background.padding_right=6
)

if /usr/bin/pgrep -qx AeroSpace >/dev/null 2>&1 && [ -x /opt/homebrew/bin/aerospace ]; then
  while IFS='|' read -r sketchybar_display_id display_name; do
    [ -n "$sketchybar_display_id" ] || continue
    case "$display_name" in
      *Built-in*)
        add_workspace_group "built_in" "$sketchybar_display_id" "0"
        break
        ;;
    esac
  done < <(/opt/homebrew/bin/aerospace list-monitors --format '%{monitor-appkit-nsscreen-screens-id}|%{monitor-name}')
else
  add_workspace_group "rift" "" "0"
fi

space_observer=(
  drawing=off
  updates=on
  update_freq=1
  width=0
  padding_left=0
  padding_right=0
  script="$PLUGIN_DIR/spaces.sh"
)
"$SKETCHYBAR_BIN" --add item space_observer left \
                  --set space_observer "${space_observer[@]}" \
                  --subscribe space_observer workspace_change

front_app=(
  width=190
  label.max_chars=24
  label.align=left
  label.color="$TEXT_MUTED"
  label.font="CaskaydiaCove Nerd Font:SemiBold:12.0"
  background.drawing=on
  background.color="$GLASS_BG"
  background.border_color="$GLASS_BORDER"
  script="$PLUGIN_DIR/front_app.sh"
)
"$SKETCHYBAR_BIN" --add item front_app left \
                  --set front_app "${front_app[@]}" \
                  --subscribe front_app front_app_switched

music=(
  updates=on
  update_freq=5
  display=2
  drawing=off
  width=260
  icon.drawing=on
  icon=""
  icon.font="CaskaydiaCove Nerd Font:Regular:13.0"
  icon.color="$TEXT_DIM"
  icon.padding_left=10
  icon.padding_right=0
  label.max_chars=38
  label.align=left
  label.color="$TEXT"
  label.font="CaskaydiaCove Nerd Font:SemiBold:12.0"
  background.drawing=on
  background.color="$GLASS_BG"
  background.border_color="$GLASS_BORDER"
  script="$PLUGIN_DIR/music.sh"
)
"$SKETCHYBAR_BIN" --add item music center \
                  --set music "${music[@]}"

battery=(
  update_freq=60
  background.drawing=on
  background.height=28
  background.corner_radius=14
  background.color="$GLASS_BG"
  background.border_color="$GLASS_BORDER"
  background.border_width=1
  icon.padding_left=8
  icon.padding_right=3
  label.padding_left=2
  label.padding_right=10
  script="$PLUGIN_DIR/battery.sh"
)
"$SKETCHYBAR_BIN" --add item battery right \
                  --set battery "${battery[@]}" \
                  --subscribe battery power_source_change system_woke

clock=(
  update_freq=30
  background.drawing=on
  background.color="$GLASS_BG"
  background.border_color="$GLASS_BORDER"
  label.color="$TEXT"
  label.padding_left=10
  label.padding_right=10
  script="$PLUGIN_DIR/clock.sh"
)
"$SKETCHYBAR_BIN" --add item clock right \
                  --set clock "${clock[@]}"

"$SKETCHYBAR_BIN" --update

focused_workspace="$(focused_workspace)"

if [ -n "$focused_workspace" ]; then
  "$SKETCHYBAR_BIN" --trigger workspace_change FOCUSED="$focused_workspace" REFRESH=all
else
  "$SKETCHYBAR_BIN" --trigger workspace_change REFRESH=all
fi
