#!/bin/bash

SKETCHYBAR_BIN="/opt/homebrew/bin/sketchybar"
RIFT_CLI="/opt/homebrew/bin/rift-cli"
PLUGIN_DIR="$CONFIG_DIR/plugins"

TRANSPARENT=0x00000000
TEXT=0xeef5f7fa
TEXT_STRONG=0xffffffff

theme_file="${XDG_CONFIG_HOME:-$HOME/.config}/theme/sketchybar.env"
[ -r "$theme_file" ] && . "$theme_file"

WORKSPACE_ACTIVE="${WORKSPACE_ACTIVE:-0xcff5f7fa}"
WORKSPACE_INACTIVE="${WORKSPACE_INACTIVE:-0x78f5f7fa}"
WORKSPACE_SEPARATOR="${WORKSPACE_SEPARATOR:-0x44f5f7fa}"

focused_workspace() {
  if /usr/bin/pgrep -qx AeroSpace >/dev/null 2>&1 && [ -x /opt/homebrew/bin/aerospace ]; then
    /opt/homebrew/bin/aerospace list-workspaces --focused 2>/dev/null | head -n 1
    return
  fi

  "$RIFT_CLI" query workspaces 2>/dev/null \
    | tr '{' '\n' \
    | sed -nE 's/.*"index"[[:space:]]*:[[:space:]]*([0-9]+).*"is_active"[[:space:]]*:[[:space:]]*true.*/\1/p' \
    | head -n 1 \
    | awk '{ print $1 + 1 }'
}

add_workspace_item() {
  local workspace_id="$1"
  local local_workspace="$2"
  local display_id="${3:-}"
  local item_name="space.$workspace_id.$local_workspace"
  local workspace_index=$((local_workspace - 1))
  local display_arg=()

  if [ -n "$display_id" ]; then
    display_arg=(display="$display_id")
  fi

  item=(
    "${display_arg[@]}"
    width=24
    padding_left=2
    padding_right=2
    label="$local_workspace"
    label.width=24
    label.align=center
    label.color="$WORKSPACE_INACTIVE"
    label.padding_left=0
    label.padding_right=0
    background.drawing=off
    click_script="/bin/sh -lc 'if /usr/bin/pgrep -qx AeroSpace && [ -x /opt/homebrew/bin/aerospace ]; then /opt/homebrew/bin/aerospace workspace $workspace_id; else /opt/homebrew/bin/rift-cli execute workspace switch $workspace_index; fi'"
  )

  "$SKETCHYBAR_BIN" --add item "$item_name" left \
                    --set "$item_name" "${item[@]}"
}

add_separator_item() {
  local workspace_id="$1"
  local display_id="${2:-}"
  local item_name="space.separator.$workspace_id"
  local display_arg=()

  if [ -n "$display_id" ]; then
    display_arg=(display="$display_id")
  fi

  item=(
    "${display_arg[@]}"
    width=18
    padding_left=0
    padding_right=0
    label="|"
    label.width=18
    label.align=center
    label.color="$WORKSPACE_SEPARATOR"
    label.padding_left=0
    label.padding_right=0
    background.drawing=off
  )

  "$SKETCHYBAR_BIN" --add item "$item_name" left \
                    --set "$item_name" "${item[@]}"
}

add_workspace_group() {
  local display_id="${1:-}"
  local offset="$2"
  local count="${3:-9}"
  local workspace_id

  for local_workspace in $(seq 1 "$count"); do
    workspace_id="$((offset + local_workspace))"
    add_workspace_item "$workspace_id" "$local_workspace" "$display_id"
    if [ "$local_workspace" -lt "$count" ]; then
      add_separator_item "$workspace_id" "$display_id"
    fi
  done
}

bar=(
  position=top
  display=all
  height=24
  margin=0
  y_offset=0
  corner_radius=0
  blur_radius=0
  color="$TRANSPARENT"
  border_width=0
  border_color="$TRANSPARENT"
  padding_left=12
  padding_right=12
  sticky=on
  topmost=window
  shadow=off
  font_smoothing=on
)
"$SKETCHYBAR_BIN" --bar "${bar[@]}"

default=(
  updates=when_shown
  drawing=on
  icon.drawing=off
  label.color="$TEXT"
  label.highlight_color="$TEXT_STRONG"
  label.font="CaskaydiaCove Nerd Font:Regular:13.0"
  label.padding_left=0
  label.padding_right=0
  background.drawing=off
  blur_radius=0
  padding_left=0
  padding_right=0
)
"$SKETCHYBAR_BIN" --default "${default[@]}"

"$SKETCHYBAR_BIN" --add event workspace_change

if /usr/bin/pgrep -qx AeroSpace >/dev/null 2>&1 && [ -x /opt/homebrew/bin/aerospace ]; then
  workspace_group_added=0
  while IFS='|' read -r sketchybar_display_id display_name; do
    [ -n "$sketchybar_display_id" ] || continue
    case "$display_name" in
      *Built-in*)
        add_workspace_group "$sketchybar_display_id" "0" "9"
        workspace_group_added=1
        break
        ;;
    esac
  done < <(/opt/homebrew/bin/aerospace list-monitors --format '%{monitor-appkit-nsscreen-screens-id}|%{monitor-name}')

  if [ "$workspace_group_added" -eq 0 ]; then
    add_workspace_group "" "0" "9"
  fi
else
  add_workspace_group "" "0" "5"
fi

space_observer=(
  drawing=off
  updates=on
  update_freq=1
  width=0
  padding_left=0
  padding_right=0
  script="$PLUGIN_DIR/spaces.sh"
)
"$SKETCHYBAR_BIN" --add item space_observer left \
                  --set space_observer "${space_observer[@]}" \
                  --subscribe space_observer workspace_change

"$SKETCHYBAR_BIN" --update

focused_workspace="$(focused_workspace)"

if [ -n "$focused_workspace" ]; then
  "$SKETCHYBAR_BIN" --trigger workspace_change FOCUSED="$focused_workspace" REFRESH=all
else
  "$SKETCHYBAR_BIN" --trigger workspace_change REFRESH=all
fi
