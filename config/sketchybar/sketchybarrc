#!/bin/bash

SKETCHYBAR_BIN="/opt/homebrew/bin/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

. "$PLUGIN_DIR/theme.sh"
. "$PLUGIN_DIR/window-manager.sh"

bar=(
  position=top
  display=all
  height=44
  margin=0
  y_offset=0
  corner_radius=0
  blur_radius=72
  color="$TRANSPARENT"
  border_width=0
  border_color="$TRANSPARENT"
  padding_left=10
  padding_right=10
  sticky=on
  topmost=window
  shadow=off
  font_smoothing=on
)
"$SKETCHYBAR_BIN" --bar "${bar[@]}"

default=(
  updates=when_shown
  drawing=on
  icon.drawing=off
  label.color="$TEXT"
  label.highlight_color="$TEXT_STRONG"
  label.font="CaskaydiaCove Nerd Font:Regular:12.0"
  label.padding_left=10
  label.padding_right=10
  background.drawing=on
  background.height=30
  background.corner_radius=15
  background.color="$GLASS_BG"
  background.border_width=1
  background.border_color="$GLASS_BORDER"
  blur_radius=0
  padding_left=4
  padding_right=4
)
"$SKETCHYBAR_BIN" --default "${default[@]}"

"$SKETCHYBAR_BIN" --add event workspace_change

for sid in 1 2 3 4 5; do
  item=(
    width=26
    padding_left=3
    padding_right=3
    label="$sid"
    label.width=26
    label.align=center
    label.font="CaskaydiaCove Nerd Font:SemiBold:12.0"
    label.color="$TEXT_DIM"
    label.padding_left=0
    label.padding_right=0
    background.drawing=on
    background.height=24
    background.corner_radius=12
    background.padding_left=0
    background.padding_right=0
    background.color="$TRANSPARENT"
    background.border_color="$TRANSPARENT"
    background.border_width=0
    background.y_offset=0
    script="$PLUGIN_DIR/workspace.sh"
    click_script="/bin/sh -lc '. \"$PLUGIN_DIR/window-manager.sh\"; switch_workspace $sid'"
  )

  "$SKETCHYBAR_BIN" --add item "space.$sid" left \
                    --set "space.$sid" "${item[@]}" \
                    --subscribe "space.$sid" mouse.entered mouse.exited
done

spaces=(
  background.drawing=on
  background.height=32
  background.corner_radius=16
  background.color="$GLASS_BG_STRONG"
  background.border_width=1
  background.border_color="$GLASS_BORDER"
  background.padding_left=5
  background.padding_right=5
)
"$SKETCHYBAR_BIN" --add bracket spaces '/space\..*/' \
                  --set spaces "${spaces[@]}"

space_observer=(
  drawing=off
  updates=on
  update_freq=1
  width=0
  padding_left=0
  padding_right=0
  script="$PLUGIN_DIR/spaces.sh"
)
"$SKETCHYBAR_BIN" --add item space_observer left \
                  --set space_observer "${space_observer[@]}" \
                  --subscribe space_observer workspace_change

front_app=(
  width=220
  icon.drawing=on
  icon="󰣆"
  icon.font="CaskaydiaCove Nerd Font:Regular:14.0"
  icon.color="$ACCENT"
  icon.padding_left=10
  icon.padding_right=0
  label.max_chars=26
  label.align=left
  label.color="$TEXT"
  label.font="CaskaydiaCove Nerd Font:SemiBold:12.0"
  background.drawing=on
  background.color="$GLASS_BG_STRONG"
  background.border_color="$GLASS_BORDER"
  script="$PLUGIN_DIR/front_app.sh"
)
"$SKETCHYBAR_BIN" --add item front_app left \
                  --set front_app "${front_app[@]}" \
                  --subscribe front_app front_app_switched

music=(
  updates=on
  update_freq=5
  display=2
  drawing=off
  width=286
  icon.drawing=on
  icon=""
  icon.font="CaskaydiaCove Nerd Font:Regular:14.0"
  icon.color="$ACCENT_ALT"
  icon.padding_left=10
  icon.padding_right=0
  label.max_chars=40
  label.align=left
  label.color="$TEXT"
  label.font="CaskaydiaCove Nerd Font:SemiBold:12.0"
  background.drawing=on
  background.color="$GLASS_BG_STRONG"
  background.border_color="$ACCENT_ALT_SOFT"
  script="$PLUGIN_DIR/music.sh"
)
"$SKETCHYBAR_BIN" --add item music center \
                  --set music "${music[@]}"

battery=(
  update_freq=60
  background.drawing=on
  background.height=30
  background.corner_radius=15
  background.color="$GLASS_BG_STRONG"
  background.border_color="$GLASS_BORDER"
  background.border_width=1
  icon.padding_left=8
  icon.padding_right=3
  label.padding_left=2
  label.padding_right=10
  script="$PLUGIN_DIR/battery.sh"
)
"$SKETCHYBAR_BIN" --add item battery right \
                  --set battery "${battery[@]}" \
                  --subscribe battery power_source_change system_woke

clock=(
  update_freq=30
  icon.drawing=on
  icon="󰥔"
  icon.font="CaskaydiaCove Nerd Font:Regular:14.0"
  icon.color="$ACCENT"
  icon.padding_left=10
  icon.padding_right=0
  background.drawing=on
  background.color="$GLASS_BG_STRONG"
  background.border_color="$GLASS_BORDER"
  label.color="$TEXT"
  label.padding_left=10
  label.padding_right=10
  script="$PLUGIN_DIR/clock.sh"
)
"$SKETCHYBAR_BIN" --add item clock right \
                  --set clock "${clock[@]}"

"$SKETCHYBAR_BIN" --update

focused_workspace="$(focused_workspace)"

if [ -n "$focused_workspace" ]; then
  "$SKETCHYBAR_BIN" --trigger workspace_change FOCUSED="$focused_workspace" REFRESH=all
else
  "$SKETCHYBAR_BIN" --trigger workspace_change REFRESH=all
fi
