{
  "global": {
    "check_for_updates_on_startup": false,
    "show_in_menu_bar": true,
    "show_profile_name_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Default",
      "selected": true,
      "complex_modifications": {
        "parameters": {
          "basic.to_delayed_action_delay_milliseconds": 180,
          "basic.to_if_alone_timeout_milliseconds": 180,
          "basic.to_if_held_down_threshold_milliseconds": 180
        },
        "rules": [
          {
            "description": "Use held f as a Vim-style navigation layer",
            "manipulators": [
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "variable_if",
                    "name": "f_navigation_layer",
                    "value": 1
                  }
                ],
                "from": {
                  "key_code": "h"
                },
                "to": [
                  {
                    "key_code": "left_arrow"
                  }
                ]
              },
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "variable_if",
                    "name": "f_navigation_layer",
                    "value": 1
                  }
                ],
                "from": {
                  "key_code": "j"
                },
                "to": [
                  {
                    "key_code": "down_arrow"
                  }
                ]
              },
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "variable_if",
                    "name": "f_navigation_layer",
                    "value": 1
                  }
                ],
                "from": {
                  "key_code": "k"
                },
                "to": [
                  {
                    "key_code": "up_arrow"
                  }
                ]
              },
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "variable_if",
                    "name": "f_navigation_layer",
                    "value": 1
                  }
                ],
                "from": {
                  "key_code": "l"
                },
                "to": [
                  {
                    "key_code": "right_arrow"
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "f"
                },
                "to_if_alone": [
                  {
                    "key_code": "f",
                    "halt": true
                  }
                ],
                "to_if_held_down": [
                  {
                    "set_variable": {
                      "name": "f_navigation_layer",
                      "value": 1
                    }
                  }
                ],
                "to_delayed_action": {
                  "to_if_canceled": [
                    {
                      "key_code": "f"
                    }
                  ]
                },
                "to_after_key_up": [
                  {
                    "set_variable": {
                      "name": "f_navigation_layer",
                      "value": 0
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "devices": [],
      "fn_function_keys": [],
      "simple_modifications": [],
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "ansi"
      }
    }
  ]
}
