(defsrc
  caps f h j k l u i o p m comm . scln
  lmet rmet a c r s t v w x y z
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
)

(defalias
  capctl (tap-hold 200 180 (tap-dance-eager 200 (esc f12)) lctl)
  fnav (tap-hold-press 200 180 f (layer-while-held navigation))
  cmd (layer-while-held command)
)

(deflayer base
  @capctl @fnav h j k l u i o p m comm . scln
  @cmd @cmd a c r s t v w x y z
  brdn brup mctl sls dtn dnd prev pp next mute vold volu
)

(deflayer navigation
  XX XX left down up rght lbrc rbrc S-lbrc S-rbrc / bksl S-/ bspc
  XX XX XX XX XX XX XX XX XX XX XX XX
  brdn brup mctl sls dtn dnd prev pp next mute vold volu
)

(deflayer command
  XX C-f XX XX XX XX XX XX XX XX XX XX XX XX
  lmet rmet C-a M-c C-r C-s C-t M-v C-w C-x C-y C-z
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
)
