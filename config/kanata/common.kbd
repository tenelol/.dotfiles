(defsrc
  caps f v h j k l u i o p n m comm . scln / lmet
  a e spc
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
)

(defalias
  caps-prefix (one-shot 900 (layer-while-held caps-prefix))
  quickterm (cmd /bin/sh -lc "exec /bin/launchctl asuser $(/usr/bin/id -u tener) /usr/bin/sudo -n -u tener /Users/tener/.local/bin/toggle-ghostty-quick-terminal")
  capctl (tap-hold 200 180 (tap-dance-eager 200 (esc @caps-prefix)) lctl)
  fsyms (tap-hold-tap-keys 200 150 f (layer-while-held symbols) (a e i o u))
  vnav (tap-hold-tap-keys 200 150 v (layer-while-held navigation) (a e i o u))
  scru (mwheel-up 50 120)
  scrd (mwheel-down 50 120)
  mleft (movemouse-accel-left 1 1000 1 12)
  mdown (movemouse-accel-down 1 1000 1 12)
  mup (movemouse-accel-up 1 1000 1 12)
  mright (movemouse-accel-right 1 1000 1 12)
  ime C-spc
  lcmd (tap-hold-press 200 180 @ime lmet)
)

(deflayer base
  @capctl @fsyms @vnav h j k l u i o p n m comm . scln / @lcmd
  a e spc
  brdn brup mctl sls dtn dnd prev pp next mute vold volu
)

(deflayer caps-prefix
  XX XX XX C-b XX XX XX XX XX XX @quickterm XX XX XX XX XX XX XX
  XX XX XX
  XX XX XX XX XX XX XX XX XX XX XX XX
)

(deflayer symbols
  XX XX XX S-9 lbrc rbrc S-0 S-lbrc S-rbrc S-comm S-. S-= - = bksl bspc S-bksl XX
  XX XX spc
  brdn brup mctl sls dtn dnd prev pp next mute vold volu
)

(deflayer navigation
  XX XX XX left down up rght home end @scru @scrd @mleft @mdown @mup @mright XX mrtp XX
  XX XX mltp
  brdn brup mctl sls dtn dnd prev pp next mute vold volu
)
