(defcfg
  process-unmapped-keys (all-except f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12)
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

(defsrc
  caps f h j k l u i o p m comm .
)

(defalias
  capctl (tap-hold 200 180 (tap-dance-eager 200 (esc f12)) lctl)
  fnav (tap-hold 200 180 f (layer-while-held navigation))
)

(deflayer base
  @capctl @fnav h j k l u i o p m comm .
)

(deflayer navigation
  XX XX left down up rght lbrc rbrc S-lbrc S-rbrc / bksl S-/
)
