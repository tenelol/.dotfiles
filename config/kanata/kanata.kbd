(defcfg
  process-unmapped-keys yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

(defsrc
  caps f h j k l
)

(defalias
  capctl (tap-hold 200 180 esc lctl)
  fnav (tap-hold 200 180 f (layer-while-held navigation))
)

(deflayer base
  @capctl @fnav h j k l
)

(deflayer navigation
  XX XX left down up rght
)
