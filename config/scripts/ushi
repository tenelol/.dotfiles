#!/usr/bin/env bash

set -euo pipefail

random_face=false
use_lolcat=false

print_help() {
  cat <<'EOF'
ushiCLI

Usage:
  ushi [options]

Options:
  -r, --random-f  cowsay の -f を毎回ランダムに選ぶ
  -L, --lolcat    出力を lolcat で色付けする
  -h, --help      このヘルプを表示
EOF
}

require_cowsay() {
  if ! command -v cowsay >/dev/null 2>&1; then
    echo "cowsay command not found" >&2
    exit 1
  fi
}

require_lolcat() {
  if [[ "$use_lolcat" == true ]] && ! command -v lolcat >/dev/null 2>&1; then
    echo "lolcat command not found" >&2
    exit 1
  fi
}

pick_random_face() {
  cowsay -l \
    | tail -n +2 \
    | tr '[:space:]' '\n' \
    | sed '/^$/d' \
    | awk 'BEGIN { srand() } { faces[++n] = $0 } END { if (n > 0) print faces[int(rand() * n) + 1] }'
}

run_cowsay() {
  local text="$1"
  local output

  if [[ "$random_face" == true ]]; then
    local face
    face="$(pick_random_face)"
    if [[ -n "$face" ]]; then
      output="$(cowsay -f "$face" "$text")"
    else
      output="$(cowsay "$text")"
    fi
  else
    output="$(cowsay "$text")"
  fi

  if [[ "$use_lolcat" == true ]]; then
    printf '%s\n' "$output" | lolcat
    return
  fi

  printf '%s\n' "$output"
}

run_repl() {
  trap 'printf "\n終了しました。\n"; exit 0' INT TERM

  echo "ushiCLI"
  echo "文字列を入力すると cowsay で返します。Ctrl+C または Ctrl+D で終了。"
  if [[ "$random_face" == true ]]; then
    echo "random-f: ON"
  fi
  if [[ "$use_lolcat" == true ]]; then
    echo "lolcat: ON"
  fi

  while true; do
    printf 'ushi> '
    if ! IFS= read -r line; then
      printf "\n終了しました。\n"
      break
    fi

    case "$line" in
      "") continue ;;
      exit|quit|:q)
        printf "終了しました。\n"
        break
        ;;
      *)
        run_cowsay "$line"
        ;;
    esac
  done
}

main() {
  require_cowsay

  while (($# > 0)); do
    case "$1" in
      -r|--random-f)
        random_face=true
        ;;
      -L|--lolcat)
        use_lolcat=true
        ;;
      -[!-]?*)
        local short_flags="${1#-}"
        local i
        for ((i = 0; i < ${#short_flags}; i++)); do
          case "${short_flags:i:1}" in
            r)
              random_face=true
              ;;
            L)
              use_lolcat=true
              ;;
            h)
              print_help
              exit 0
              ;;
            *)
              echo "Unknown option: -${short_flags:i:1}" >&2
              exit 1
              ;;
          esac
        done
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        echo "Unknown option: $1" >&2
        exit 1
        ;;
    esac
    shift
  done

  require_lolcat

  if [[ -t 0 ]]; then
    run_repl
    exit 0
  fi

  local input
  input="$(cat)"
  input="${input%$'\n'}"
  if [[ -n "$input" ]]; then
    run_cowsay "$input"
  fi
}

main "$@"
