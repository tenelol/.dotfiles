#!/usr/bin/env bash
set -euo pipefail

vault_root="${VAULT_GIT_SYNC_ROOT:-/Users/tener/obsidian}"
[[ -d "${vault_root}" ]] || {
  printf '{"ok":false,"status":"blocked","reason":"not_a_git_repository"}\n'
  exit 1
}
vault_root="$(cd "${vault_root}" && pwd -P)"
vault_cli="${VAULT_CONTEXT_CLI:-/Users/tener/.codex/bin/vault-context}"
secret_scanner="${VAULT_CONTEXT_SECRET_SCANNER:-/Users/tener/.codex/mcp/vault-context-mcp/dist/scripts/check-sensitive-stdin.js}"
expected_remote="${VAULT_GIT_EXPECTED_REMOTE:-git@github.com:tenelol/obsidian.git}"
branch="${VAULT_GIT_BRANCH:-main}"
if [[ "${expected_remote}" == git@github.com:* ]]; then
  export GIT_SSH_COMMAND="${VAULT_GIT_SYNC_SSH_COMMAND:-ssh -4 -p 443 -o HostName=ssh.github.com -o HostKeyAlias=github.com -o ConnectTimeout=20}"
fi
lock_dir="${vault_root}/.vault-context/git-sync.lock"
pending_file="${vault_root}/.vault-context/pending-push"
staged_by_script=0
lock_acquired=0
temp_dir=""

fail() {
  local reason="$1"
  printf '{"ok":false,"status":"blocked","reason":"%s"}\n' "${reason}"
  exit 1
}

cleanup() {
  local exit_status=$?
  local cleanup_paths=""
  if [[ -n "${temp_dir}" ]]; then
    cleanup_paths="${temp_dir}/staged-paths"
    if [[ ! -s "${cleanup_paths}" ]]; then
      cleanup_paths="${temp_dir}/stage-candidates"
    fi
  fi
  if [[ "${staged_by_script}" == "1" && -s "${cleanup_paths}" ]]; then
    git -C "${vault_root}" restore --staged \
      --pathspec-from-file="${cleanup_paths}" \
      --pathspec-file-nul >/dev/null 2>&1 || true
  fi
  if [[ -n "${temp_dir}" && -d "${temp_dir}" ]]; then
    rm -rf -- "${temp_dir}/snapshot"
    rm -f -- "${temp_dir}/quality.json" "${temp_dir}/reindex.json" "${temp_dir}/stage-candidates" "${temp_dir}/post-validation-changes" "${temp_dir}/staged-paths" "${temp_dir}/staged-status"
    rmdir "${temp_dir}" 2>/dev/null || true
  fi
  if [[ "${lock_acquired}" == "1" ]]; then
    rm -f -- "${lock_dir}/pid"
    rmdir "${lock_dir}" 2>/dev/null || true
  fi
  return "${exit_status}"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

[[ -d "${vault_root}/.git" ]] || fail "not_a_git_repository"
[[ -x "${vault_cli}" ]] || fail "vault_cli_missing"
[[ -f "${secret_scanner}" ]] || fail "secret_scanner_missing"

mkdir -p "${vault_root}/.vault-context"
if ! mkdir "${lock_dir}" 2>/dev/null; then
  if [[ -f "${lock_dir}/pid" ]]; then
    read -r existing_pid < "${lock_dir}/pid" || true
    if [[ "${existing_pid:-}" =~ ^[0-9]+$ ]] && kill -0 "${existing_pid}" 2>/dev/null; then
      fail "already_running"
    fi
  fi
  rm -f -- "${lock_dir}/pid"
  rmdir "${lock_dir}" 2>/dev/null || fail "lock_unavailable"
  mkdir "${lock_dir}" || fail "lock_unavailable"
fi
lock_acquired=1
printf '%s\n' "$$" > "${lock_dir}/pid"

temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/vault-git-sync.XXXXXX")"
: > "${temp_dir}/staged-paths"
: > "${temp_dir}/stage-candidates"

repository_root="$(git -C "${vault_root}" rev-parse --show-toplevel 2>/dev/null)" || fail "git_root_unavailable"
[[ "${repository_root}" == "${vault_root}" ]] || fail "unexpected_git_root"
[[ "$(git -C "${vault_root}" branch --show-current)" == "${branch}" ]] || fail "unexpected_branch"
[[ "$(git -C "${vault_root}" remote get-url origin)" == "${expected_remote}" ]] || fail "unexpected_remote"
git -C "${vault_root}" diff --cached --quiet || fail "preexisting_staged_changes"
[[ -z "$(git -C "${vault_root}" ls-files -u)" ]] || fail "unmerged_paths"

git -C "${vault_root}" fetch --quiet origin "${branch}" || fail "fetch_failed"
read -r ahead_count behind_count < <(
  git -C "${vault_root}" rev-list --left-right --count "HEAD...origin/${branch}"
)

retried_pending=0
if [[ "${behind_count}" != "0" ]]; then
  fail "remote_diverged"
fi
if [[ "${ahead_count}" != "0" ]]; then
  [[ -f "${pending_file}" ]] || fail "unrecognized_local_commits"
  read -r pending_commit < "${pending_file}" || fail "invalid_pending_push"
  [[ "${pending_commit}" =~ ^[0-9a-f]{40}$ ]] || fail "invalid_pending_push"
  [[ "${pending_commit}" == "$(git -C "${vault_root}" rev-parse HEAD)" ]] || fail "pending_push_mismatch"
  git -C "${vault_root}" push --quiet origin "HEAD:${branch}" || fail "pending_push_failed"
  rm -f -- "${pending_file}"
  retried_pending=1
fi

allowlist=(".gitignore" "00 Inbox" "10 Records" "20 Synthesis" "90 System")
git -C "${vault_root}" ls-files -z --modified --deleted --others --exclude-standard -- \
  "${allowlist[@]}" > "${temp_dir}/stage-candidates"
if [[ -s "${temp_dir}/stage-candidates" ]]; then
  git -C "${vault_root}" add -A \
    --pathspec-from-file="${temp_dir}/stage-candidates" \
    --pathspec-file-nul
  staged_by_script=1
fi
git -C "${vault_root}" diff --cached --name-only -z > "${temp_dir}/staged-paths"

validated_tree="$(git -C "${vault_root}" write-tree)" || fail "staged_tree_unavailable"
snapshot="${temp_dir}/snapshot"
mkdir "${snapshot}"
git -C "${vault_root}" checkout-index --all --force --prefix="${snapshot}/" ||
  fail "snapshot_failed"
VAULT_CONTEXT_ROOT="${snapshot}" \
  VAULT_CONTEXT_INDEX="${snapshot}/.vault-context/index.sqlite" \
  "${vault_cli}" reindex --json > "${temp_dir}/reindex.json" ||
  fail "reindex_failed"
VAULT_CONTEXT_ROOT="${snapshot}" \
  VAULT_CONTEXT_INDEX="${snapshot}/.vault-context/index.sqlite" \
  "${vault_cli}" quality --json > "${temp_dir}/quality.json" ||
  fail "quality_failed"
quality_failures="$({
  jq -ce '
    [
      {check: "raw_integrity_failures", count: .summary.raw_integrity_failures},
      {check: "sensitive_quarantined", count: .summary.sensitive_quarantined},
      {check: "noncanonical_quarantined", count: .summary.noncanonical_quarantined},
      {check: "schema_violations", count: .summary.schema_violations},
      {check: "broken_links", count: .summary.broken_links},
      {check: "missing_summary", count: .summary.missing_summary},
      {check: "missing_scope_or_project", count: .summary.missing_scope_or_project}
    ]
    | if all(.[]; ((.count | type) == "number") and .count >= 0 and (.count | floor) == .count)
      then map(select(.count != 0))
      else error("invalid quality summary")
      end
  ' "${temp_dir}/quality.json"
} 2>/dev/null)" || fail "quality_output_invalid"
if [[ "${quality_failures}" != "[]" ]]; then
  jq -cn --argjson failed_checks "${quality_failures}" \
    '{ok: false, status: "blocked", reason: "quality_gate_failed", failed_checks: $failed_checks}'
  exit 1
fi

git -C "${vault_root}" ls-files -z --modified --deleted --others --exclude-standard -- \
  "${allowlist[@]}" > "${temp_dir}/post-validation-changes"
[[ ! -s "${temp_dir}/post-validation-changes" ]] ||
  fail "vault_changed_during_validation"
[[ "$(git -C "${vault_root}" write-tree)" == "${validated_tree}" ]] ||
  fail "index_changed_during_validation"

if [[ ! -s "${temp_dir}/staged-paths" ]]; then
  staged_by_script=0
  if [[ "${retried_pending}" == "1" ]]; then
    printf '{"ok":true,"status":"pushed_pending"}\n'
  else
    printf '{"ok":true,"status":"noop"}\n'
  fi
  exit 0
fi

git -C "${vault_root}" diff --cached --name-status --no-renames -z > "${temp_dir}/staged-status"
while IFS= read -r -d '' staged_status &&
  IFS= read -r -d '' path; do
  case "${path}" in
    "00 Inbox/raw/"*)
      [[ "${staged_status}" == "A" ]] || fail "immutable_raw_changed"
      ;;
  esac
done < "${temp_dir}/staged-status"

while IFS= read -r -d '' path; do
  case "${path}" in
    .gitignore | "00 Inbox/"*.md | "10 Records/"*.md | "20 Synthesis/"*.md | "90 System/"*.md | "90 System/"*.json | "90 System/"*.yaml | "90 System/"*.yml | "90 System/"*.toml | "90 System/"*.txt)
      ;;
    *)
      fail "disallowed_staged_path"
      ;;
  esac
  if git -C "${vault_root}" cat-file -e ":${path}" 2>/dev/null; then
    blob_size="$(git -C "${vault_root}" cat-file -s ":${path}")"
    (( blob_size <= 10485760 )) || fail "staged_file_too_large"
    if ! git -C "${vault_root}" cat-file blob ":${path}" |
      node "${secret_scanner}" >/dev/null; then
      fail "staged_secret_suspected"
    fi
  fi
done < "${temp_dir}/staged-paths"

git -C "${vault_root}" diff --cached --check || fail "staged_diff_invalid"
if ! git -C "${vault_root}" diff --cached --no-ext-diff --unified=0 -- "${allowlist[@]}" |
  node "${secret_scanner}" >/dev/null; then
  fail "staged_secret_suspected"
fi
[[ "$(git -C "${vault_root}" write-tree)" == "${validated_tree}" ]] ||
  fail "index_changed_during_validation"

# Commit the exact audited tree. `git commit` would reread a concurrently
# mutable index; the explicit tree plus compare-and-swap ref update cannot
# include content that bypassed the quality and secret gates above.
commit_time="$(TZ=Asia/Tokyo date '+%Y-%m-%d %H:%M JST')"
parent_sha="$(git -C "${vault_root}" rev-parse HEAD)"
commit_sha="$(
  printf 'chore: sync Vault %s\n' "${commit_time}" |
    git -C "${vault_root}" commit-tree "${validated_tree}" -p "${parent_sha}"
)" || fail "commit_failed"
git -C "${vault_root}" update-ref "refs/heads/${branch}" "${commit_sha}" "${parent_sha}" ||
  fail "commit_failed"
staged_by_script=0
printf '%s\n' "${commit_sha}" > "${pending_file}"

if ! git -C "${vault_root}" push --quiet origin "HEAD:${branch}"; then
  printf '{"ok":false,"status":"push_pending","reason":"push_failed","commit":"%s"}\n' "${commit_sha}"
  exit 1
fi
rm -f -- "${pending_file}"
printf '{"ok":true,"status":"committed_and_pushed","commit":"%s"}\n' "${commit_sha}"
