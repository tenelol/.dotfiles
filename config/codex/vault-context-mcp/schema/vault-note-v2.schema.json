{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vault-note/v2",
  "title": "AI-first Vault note frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "kind",
    "lifecycle",
    "status",
    "summary",
    "created",
    "updated",
    "source_kind"
  ],
  "properties": {
    "schema": { "const": "vault-note/v2" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "kind": {
      "enum": [
        "decision", "handoff", "risk", "learning", "task", "note", "question",
        "project", "runbook", "raw", "receipt", "daily", "weekly"
      ]
    },
    "lifecycle": { "enum": ["active", "history", "archived"] },
    "status": { "type": "string", "minLength": 1, "maxLength": 64 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "pinned": { "type": "boolean" },
    "canonical": { "type": "boolean" },
    "needs_curation": { "type": "boolean" },
    "created": { "$ref": "#/$defs/date" },
    "updated": { "$ref": "#/$defs/date" },
    "review_after": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "scope_keys": { "$ref": "#/$defs/stringArray" },
    "projects": { "$ref": "#/$defs/relationArray" },
    "owners": { "$ref": "#/$defs/stringArray" },
    "source_kind": {
      "enum": ["user", "agent", "repository", "runtime", "ci", "web", "import", "mixed", "unknown"]
    },
    "source_detail": { "type": ["string", "null"] },
    "evidence": { "$ref": "#/$defs/stringArray" },
    "confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "next_action": { "type": ["string", "null"] },
    "related": { "$ref": "#/$defs/relationArray" },
    "supersedes": { "$ref": "#/$defs/relationArray" },
    "superseded_by": { "$ref": "#/$defs/relationArray" },
    "depends_on": { "$ref": "#/$defs/relationArray" },
    "supports": { "$ref": "#/$defs/relationArray" },
    "contradicts": { "$ref": "#/$defs/relationArray" },
    "derived_from": { "$ref": "#/$defs/relationArray" },
    "source_raw": { "$ref": "#/$defs/relationArray" },
    "outputs": { "$ref": "#/$defs/relationArray" },
    "aliases": { "$ref": "#/$defs/stringArray" },
    "search_terms": { "$ref": "#/$defs/stringArray" },
    "tags": { "$ref": "#/$defs/stringArray" },
    "origin": { "type": ["string", "null"] },
    "origin_ref": { "type": ["string", "null"] },
    "legacy_context_key": { "type": ["string", "null"] },
    "captured_at": { "type": "string" },
    "processed_at": { "type": "string" },
    "immutable": { "type": "boolean" },
    "body_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_by": { "type": "string" },
    "period_start": { "$ref": "#/$defs/date" },
    "period_end": { "$ref": "#/$defs/date" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": ["decision", "handoff", "risk", "learning", "task", "note", "question", "project", "runbook"]
          }
        }
      },
      "then": {
        "required": ["priority", "pinned", "canonical", "needs_curation", "confidence"],
        "anyOf": [
          { "required": ["scope_keys"], "properties": { "scope_keys": { "minItems": 1 } } },
          { "required": ["projects"], "properties": { "projects": { "minItems": 1 } } }
        ]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "raw" } } },
      "then": {
        "required": ["immutable", "body_sha256", "captured_at"],
        "properties": { "immutable": { "const": true } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "receipt" } } },
      "then": { "required": ["derived_from", "outputs", "processed_at", "body_sha256"] }
    },
    {
      "if": { "properties": { "kind": { "const": "weekly" } } },
      "then": { "required": ["period_start", "period_end", "generated_by"] }
    }
  ],
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "relationArray": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\[\\[[^\\]]+\\]\\]$" },
      "uniqueItems": true
    }
  }
}
