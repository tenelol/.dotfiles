# Ghostty config
# See: https://ghostty.org/docs/config

# Typography
font-family = "JetBrains Mono"
font-size = 12
font-feature = "calt"

# Window feel
theme = "TokyoNight Storm"
foreground = ffffff
background = 24283b
cursor-color = 7aa2f7
selection-foreground = ffffff
selection-background = 364a82
palette = 0=24283b
palette = 1=7aa2f7
palette = 2=7aa2f7
palette = 3=7aa2f7
palette = 4=7aa2f7
palette = 5=7aa2f7
palette = 6=7aa2f7
palette = 7=ffffff
palette = 8=7aa2f7
palette = 9=7aa2f7
palette = 10=7aa2f7
palette = 11=7aa2f7
palette = 12=7aa2f7
palette = 13=7aa2f7
palette = 14=7aa2f7
palette = 15=ffffff
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = "none"
window-show-tab-bar = "never"
background-opacity = 0
background-opacity-cells = true
background-blur = 64
unfocused-split-opacity = 0.74
mouse-hide-while-typing = true

# Cursor
cursor-style = "block"

# Custom shaders
custom-shader = ~/.config/ghostty/shaders/aurora.glsl
custom-shader = ~/.config/ghostty/shaders/liquid_glass_focus.glsl
custom-shader = ~/.config/ghostty/shaders/cursor_tail.glsl
custom-shader = ~/.config/ghostty/shaders/ripple_rectangle_cursor.glsl
custom-shader-animation = true

# Quick terminal
keybind = "ctrl+shift+space=toggle_quick_terminal"
quick-terminal-position = "right"
quick-terminal-size = "30%"

# Splits
keybind = "super+n=new_window"
keybind = "super+d=new_split:right"
keybind = "super+shift+d=new_split:down"
keybind = "super+w=close_surface"
keybind = "super+alt+left=goto_split:left"
keybind = "super+alt+right=goto_split:right"
keybind = "super+alt+up=goto_split:top"
keybind = "super+alt+down=goto_split:bottom"
keybind = "super+shift+,=reload_config"

# Mac-like copy/paste
keybind = "super+c=copy_to_clipboard"
keybind = "super+v=paste_from_clipboard"

# Use a context menu on right-click.
right-click-action = "context-menu"
