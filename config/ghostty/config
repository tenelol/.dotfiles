# Ghostty config
# See: https://ghostty.org/docs/config

# Typography
font-family = "JetBrains Mono"
font-size = 12
font-feature = "calt"

# Window feel
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = "none"
window-show-tab-bar = "never"
background-opacity = 0.82
background-opacity-cells = true
background-blur = 18
unfocused-split-opacity = 0.86
mouse-hide-while-typing = true

# Cursor
cursor-style = "block"

# Quick terminal
keybind = "ctrl+shift+space=toggle_quick_terminal"
quick-terminal-position = "right"
quick-terminal-size = "30%"

# Splits
keybind = "super+n=new_window"
keybind = "super+d=new_split:right"
keybind = "super+shift+d=new_split:down"
keybind = "super+w=close_surface"
keybind = "super+alt+left=goto_split:left"
keybind = "super+alt+right=goto_split:right"
keybind = "super+alt+up=goto_split:top"
keybind = "super+alt+down=goto_split:bottom"
keybind = "super+shift+,=reload_config"

# Mac-like copy/paste
keybind = "super+c=copy_to_clipboard"
keybind = "super+v=paste_from_clipboard"

# Colors
# Keep default text colors; rely on background-opacity for transparency.

# Use a context menu on right-click.
right-click-action = "context-menu"
