# Ghostty config
# See: https://ghostty.org/docs/config

# Typography
font-family = "JetBrains Mono"
font-size = 14
font-feature = "calt"

# Window feel
theme = "TokyoNight Storm"
foreground = c0caf5
background = 24283b
cursor-color = 7aa2f7
selection-foreground = c0caf5
selection-background = 364a82
palette = 0=1f2335
palette = 1=f7768e
palette = 2=9ece6a
palette = 3=e0af68
palette = 4=7aa2f7
palette = 5=bb9af7
palette = 6=7dcfff
palette = 7=c0caf5
palette = 8=565f89
palette = 9=ff7a93
palette = 10=b9f27c
palette = 11=ffbf77
palette = 12=7aa2f7
palette = 13=c7a9ff
palette = 14=8be9ff
palette = 15=ffffff
window-padding-x = 18
window-padding-y = 15
window-padding-balance = true
window-decoration = "none"
window-show-tab-bar = "never"
background-opacity = 0
background-opacity-cells = false
background-blur = 64
unfocused-split-opacity = 0.72
mouse-hide-while-typing = true

# Cursor
cursor-style = "bar"
cursor-style-blink = false
cursor-click-to-move = true
copy-on-select = false

# Custom shaders
# Keep Persona usable by default: static glass/readability passes only.
# The animated aurora and cursor shaders can be re-enabled when GPU headroom is available.
# custom-shader = ~/.config/ghostty/shaders/aurora.glsl
custom-shader = ~/.config/ghostty/shaders/liquid_glass_focus.glsl
custom-shader = ~/.config/ghostty/shaders/readability_scrim.glsl
# custom-shader = ~/.config/ghostty/shaders/cursor_tail.glsl
# custom-shader = ~/.config/ghostty/shaders/ripple_rectangle_cursor.glsl
custom-shader-animation = false

# Quick terminal
keybind = "ctrl+shift+space=toggle_quick_terminal"
quick-terminal-position = "right"
quick-terminal-size = "38%"
quick-terminal-screen = "mouse"
quick-terminal-animation-duration = 0.16
quick-terminal-autohide = false

# Splits
keybind = "super+n=new_window"
keybind = "super+t=new_tab"
keybind = "super+d=new_split:right"
keybind = "super+shift+d=new_split:down"
keybind = "super+w=close_surface"
keybind = "super+alt+left=goto_split:left"
keybind = "super+alt+right=goto_split:right"
keybind = "super+alt+up=goto_split:top"
keybind = "super+alt+down=goto_split:bottom"
keybind = "super+shift+,=reload_config"

# Mac-like copy/paste
keybind = "super+c=copy_to_clipboard"
keybind = "super+v=paste_from_clipboard"

# Use a context menu on right-click.
right-click-action = "context-menu"
