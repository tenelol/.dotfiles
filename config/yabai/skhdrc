# AeroSpace-like bindings for yabai.
# Use keycodes for Option bindings so they do not depend on the active input source.

:: service @

alt - 0x24 : open -a Ghostty

alt - 0x2C : yabai -m space --layout bsp
alt - 0x2B : yabai -m space --layout stack

alt - 0x04 : yabai -m window --focus west
alt - 0x26 : yabai -m window --focus south
alt - 0x28 : yabai -m window --focus north
alt - 0x25 : yabai -m window --focus east

alt + shift - 0x04 : yabai -m display --focus prev
alt + shift - 0x26 : yabai -m window --warp south
alt + shift - 0x28 : yabai -m window --warp north
alt + shift - 0x25 : yabai -m display --focus next
alt + ctrl - 0x04 : yabai -m window --swap west
alt + ctrl - 0x26 : yabai -m window --swap south
alt + ctrl - 0x28 : yabai -m window --swap north
alt + ctrl - 0x25 : yabai -m window --swap east

alt - 0x1B : yabai -m window --ratio rel:-0.05
alt - 0x18 : yabai -m window --ratio rel:0.05

alt - 0x12 : yabai -m space --focus 1 || osascript -e 'tell application "System Events" to key code 18 using control down'
alt - 0x13 : yabai -m space --focus 2 || osascript -e 'tell application "System Events" to key code 19 using control down'
alt - 0x14 : yabai -m space --focus 3 || osascript -e 'tell application "System Events" to key code 20 using control down'
alt - 0x15 : yabai -m space --focus 4 || osascript -e 'tell application "System Events" to key code 21 using control down'
alt - 0x17 : yabai -m space --focus 5 || osascript -e 'tell application "System Events" to key code 23 using control down'
alt - 0x16 : yabai -m space --focus 6 || osascript -e 'tell application "System Events" to key code 22 using control down'
alt - 0x1A : yabai -m space --focus 7 || osascript -e 'tell application "System Events" to key code 26 using control down'
alt - 0x1C : yabai -m space --focus 8 || osascript -e 'tell application "System Events" to key code 28 using control down'
alt - 0x19 : yabai -m space --focus 9 || osascript -e 'tell application "System Events" to key code 25 using control down'

alt + shift - 0x12 : yabai -m window --space 1 --focus
alt + shift - 0x13 : yabai -m window --space 2 --focus
alt + shift - 0x14 : yabai -m window --space 3 --focus
alt + shift - 0x15 : yabai -m window --space 4 --focus
alt + shift - 0x17 : yabai -m window --space 5 --focus
alt + shift - 0x16 : yabai -m window --space 6 --focus
alt + shift - 0x1A : yabai -m window --space 7 --focus
alt + shift - 0x1C : yabai -m window --space 8 --focus
alt + shift - 0x19 : yabai -m window --space 9 --focus

alt - 0x30 : yabai -m space --focus prev || osascript -e 'tell application "System Events" to key code 123 using control down'
alt + shift - 0x30 : yabai -m space --focus next || osascript -e 'tell application "System Events" to key code 124 using control down'
alt + shift - 0x29 ; service

alt + shift + ctrl - 0x04 : yabai -m window --display prev; yabai -m display --focus prev
alt + shift + ctrl - 0x25 : yabai -m window --display next; yabai -m display --focus next

service < escape ; default
service < r : yabai -m space --balance; skhd -k "escape"
service < f : yabai -m window --toggle float; skhd -k "escape"
service < x : yabai -m window --toggle split; skhd -k "escape"
service < m : yabai -m space --mirror y-axis; skhd -k "escape"
service < shift - m : yabai -m space --mirror x-axis; skhd -k "escape"
service < n : yabai -m space --rotate 90; skhd -k "escape"
service < p : yabai -m space --rotate 270; skhd -k "escape"
service < alt + shift - 0x04 : yabai -m window --stack west; skhd -k "escape"
service < alt + shift - 0x26 : yabai -m window --stack south; skhd -k "escape"
service < alt + shift - 0x28 : yabai -m window --stack north; skhd -k "escape"
service < alt + shift - 0x25 : yabai -m window --stack east; skhd -k "escape"
