# AeroSpace-like bindings for yabai.
# Use keycodes for Option bindings so they do not depend on the active input source.

:: service @

alt - 0x24 : open -a Ghostty

alt - 0x2C : yabai -m space --layout bsp
alt - 0x2B : yabai -m space --layout stack

alt - 0x04 : yabai -m window --focus west
alt - 0x26 : yabai -m window --focus south
alt - 0x28 : yabai -m window --focus north
alt - 0x25 : yabai -m window --focus east

alt + shift - 0x04 : yabai -m window --warp west
alt + shift - 0x26 : yabai -m window --warp south
alt + shift - 0x28 : yabai -m window --warp north
alt + shift - 0x25 : yabai -m window --warp east

alt - 0x1B : yabai -m window --ratio rel:-0.05
alt - 0x18 : yabai -m window --ratio rel:0.05

alt - 0x12 : yabai -m space --focus 1
alt - 0x13 : yabai -m space --focus 2
alt - 0x14 : yabai -m space --focus 3
alt - 0x15 : yabai -m space --focus 4
alt - 0x17 : yabai -m space --focus 5
alt - 0x16 : yabai -m space --focus 6
alt - 0x1A : yabai -m space --focus 7
alt - 0x1C : yabai -m space --focus 8
alt - 0x19 : yabai -m space --focus 9

alt + shift - 0x12 : yabai -m window --space 1; yabai -m space --focus 1
alt + shift - 0x13 : yabai -m window --space 2; yabai -m space --focus 2
alt + shift - 0x14 : yabai -m window --space 3; yabai -m space --focus 3
alt + shift - 0x15 : yabai -m window --space 4; yabai -m space --focus 4
alt + shift - 0x17 : yabai -m window --space 5; yabai -m space --focus 5
alt + shift - 0x16 : yabai -m window --space 6; yabai -m space --focus 6
alt + shift - 0x1A : yabai -m window --space 7; yabai -m space --focus 7
alt + shift - 0x1C : yabai -m window --space 8; yabai -m space --focus 8
alt + shift - 0x19 : yabai -m window --space 9; yabai -m space --focus 9

alt - 0x30 : yabai -m space --focus recent
alt + shift - 0x30 : yabai -m space --display next
alt + shift - 0x29 ; service

service < escape ; default
service < r : yabai -m space --balance; skhd -k "escape"
service < f : yabai -m window --toggle float; skhd -k "escape"
service < alt + shift - 0x04 : yabai -m window --stack west; skhd -k "escape"
service < alt + shift - 0x26 : yabai -m window --stack south; skhd -k "escape"
service < alt + shift - 0x28 : yabai -m window --stack north; skhd -k "escape"
service < alt + shift - 0x25 : yabai -m window --stack east; skhd -k "escape"
