# Ghostty config for macOS
# See: https://ghostty.org/docs/config

# Typography
font-family = "JetBrains Mono"
font-size = 14
font-feature = "calt"
window-title-font-family = "SF Pro Text"

# Visual style
theme = "TokyoNight Storm"
foreground = c0caf5
background = 24283b
cursor-color = 7aa2f7
selection-foreground = c0caf5
selection-background = 364a82
palette = 0=171b23
palette = 1=c4a0e8
palette = 2=88c0b8
palette = 3=94b8c7
palette = 4=7f9bc4
palette = 5=a894c7
palette = 6=5f7695
palette = 7=b3bbc7
palette = 8=4f5968
palette = 9=c4a0e8
palette = 10=88c0b8
palette = 11=94b8c7
palette = 12=7f9bc4
palette = 13=a894c7
palette = 14=5f7695
palette = 15=d8dde6
window-colorspace = "display-p3"
background-opacity = 0.7
background-opacity-cells = false
# Keep transparency without compositor blur.
background-blur = false
unfocused-split-opacity = 1
window-padding-x = 18
window-padding-y = 15
window-padding-balance = true
window-save-state = "always"

# macOS window behavior
macos-titlebar-style = "hidden"
macos-hidden = "always"
macos-window-buttons = "visible"
macos-window-shadow = true
macos-option-as-alt = "left"
window-show-tab-bar = "never"

# Cursor and selection
cursor-style = "bar"
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true
copy-on-select = false
right-click-action = "context-menu"

# Custom shaders
custom-shader = ~/.config/ghostty/shaders/liquid_glass_focus.glsl
custom-shader = ~/.config/ghostty/shaders/readability_scrim.glsl
custom-shader = ~/.config/ghostty/shaders/cursor_tail.glsl
custom-shader = ~/.config/ghostty/shaders/ripple_rectangle_cursor.glsl
custom-shader-animation = always

# Quick terminal
# Ctrl+Enter toggles the quick terminal from any application.
keybind = "global:ctrl+enter=toggle_quick_terminal"
command-palette-entry = "title:Quick Terminal,action:toggle_quick_terminal"
quick-terminal-position = "center"
quick-terminal-size = "1000px,700px"
quick-terminal-screen = "mouse"
quick-terminal-animation-duration = 0.22
quick-terminal-autohide = false
quick-terminal-space-behavior = "move"

# Familiar macOS clipboard shortcuts
keybind = "super+c=copy_to_clipboard"
keybind = "super+v=paste_from_clipboard"
keybind = "super+w=close_surface"
keybind = "super+n=new_window"
keybind = "super+t=new_tab"
keybind = "super+d=new_split:right"
keybind = "super+shift+d=new_split:down"
keybind = "super+alt+left=goto_split:left"
keybind = "super+alt+right=goto_split:right"
keybind = "super+alt+up=goto_split:top"
keybind = "super+alt+down=goto_split:bottom"
keybind = "super+shift+,=reload_config"
