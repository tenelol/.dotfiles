# Ghostty config for macOS
# See: https://ghostty.org/docs/config

# Typography
# Monaspace Neon for code; italics (comments) switch to the handwritten Radon.
font-family = "Monaspace Neon"
font-family-italic = "Monaspace Radon"
font-family-bold-italic = "Monaspace Radon"
font-size = 14
# calt is Monaspace's texture healing; ss01-ss03 join ===, >= and arrows.
font-feature = "calt"
font-feature = "ss01"
font-feature = "ss02"
font-feature = "ss03"
window-title-font-family = "SF Pro Text"

# Visual style: Glacier (matches modules/nvim/files/lua/core/theme.lua)
# The foreground, background, cursor and selection lines are placeholders that
# modules/ghostty swaps for myconfig.theme.ghostty values.
foreground = c0caf5
background = 24283b
cursor-color = 7aa2f7
selection-foreground = c0caf5
selection-background = 364a82
palette = 0=11161d
palette = 1=f28b82
palette = 2=93d3c9
palette = 3=f2c37b
palette = 4=8ab4f8
palette = 5=c6a8f8
palette = 6=8fd3e8
palette = 7=c9d4e3
palette = 8=475262
palette = 9=f6a59e
palette = 10=a9e0d7
palette = 11=f6d29b
palette = 12=a8c7fa
palette = 13=d6c0fa
palette = 14=a9e1f0
palette = 15=eef3fa
window-colorspace = "display-p3"
background-opacity = 0.7
background-opacity-cells = false
# Keep transparency without compositor blur.
background-blur = false
unfocused-split-opacity = 1
window-padding-x = 18
window-padding-y = 15
window-padding-balance = true
window-save-state = "always"

# macOS window behavior
macos-titlebar-style = "hidden"
macos-hidden = "always"
macos-window-buttons = "visible"
macos-window-shadow = true
macos-option-as-alt = "left"
window-show-tab-bar = "never"

# Cursor and selection
cursor-style = "bar"
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true
copy-on-select = false
right-click-action = "context-menu"

# Custom shaders
custom-shader = ~/.config/ghostty/shaders/focus_ripple.glsl
custom-shader = ~/.config/ghostty/shaders/readability_scrim.glsl
custom-shader = ~/.config/ghostty/shaders/cursor_smear.glsl
custom-shader = ~/.config/ghostty/shaders/typing_ignite.glsl
custom-shader = ~/.config/ghostty/shaders/typing_ripple.glsl
custom-shader = ~/.config/ghostty/shaders/jump_lockon.glsl
custom-shader-animation = true

# Quick terminal
# Ctrl+Enter toggles the quick terminal from any application.
keybind = "global:ctrl+enter=toggle_quick_terminal"
command-palette-entry = "title:Quick Terminal,action:toggle_quick_terminal"
quick-terminal-position = "center"
quick-terminal-size = "1000px,700px"
quick-terminal-screen = "mouse"
quick-terminal-animation-duration = 0.22
quick-terminal-autohide = false
quick-terminal-space-behavior = "move"

# Familiar macOS clipboard shortcuts
keybind = "super+c=copy_to_clipboard"
keybind = "super+v=paste_from_clipboard"
keybind = "super+w=close_surface"
keybind = "super+n=new_window"
keybind = "super+t=new_tab"
keybind = "super+d=new_split:right"
keybind = "super+shift+d=new_split:down"
keybind = "super+alt+left=goto_split:left"
keybind = "super+alt+right=goto_split:right"
keybind = "super+alt+up=goto_split:top"
keybind = "super+alt+down=goto_split:bottom"
keybind = "super+shift+,=reload_config"
