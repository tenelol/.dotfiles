#!/usr/bin/env bash

set -euo pipefail

random_face=false
use_lolcat=false
use_think=false
list_faces=false
selected_face=""

print_help() {
  cat <<'EOF'
ushiCLI

Usage:
  ushi [options] [message...]

Options:
  -r, --random-f  cowsay の -f を毎回ランダムに選ぶ
  -f, --face      cowsay の -f を明示指定する
  -l, --list-faces  利用可能な face 一覧を表示して終了
  -L, --lolcat    出力を lolcat で色付けする
      --think     cowthink で表示する
  -h, --help      このヘルプを表示
EOF
}

require_cowsay() {
  if ! command -v cowsay >/dev/null 2>&1; then
    echo "cowsay command not found" >&2
    exit 1
  fi
}

require_cowthink() {
  if [[ "$use_think" == true ]] && ! command -v cowthink >/dev/null 2>&1; then
    echo "cowthink command not found" >&2
    exit 1
  fi
}

require_lolcat() {
  if [[ "$use_lolcat" == true ]] && ! command -v lolcat >/dev/null 2>&1; then
    echo "lolcat command not found" >&2
    exit 1
  fi
}

list_available_faces() {
  cowsay -l
}

build_cow_command() {
  if [[ "$use_think" == true ]]; then
    cow_command=(cowthink)
  else
    cow_command=(cowsay)
  fi

  if [[ "$random_face" == true ]]; then
    cow_command+=(-r)
  fi

  if [[ -n "$selected_face" ]]; then
    cow_command+=(-f "$selected_face")
  fi
}

run_cowsay() {
  local text="$1"
  local output
  local cow_command=()

  build_cow_command
  output="$("${cow_command[@]}" "$text")"

  if [[ "$use_lolcat" == true ]]; then
    printf '%s\n' "$output" | lolcat
    return
  fi

  printf '%s\n' "$output"
}

run_repl() {
  trap 'printf "\n終了しました。\n"; exit 0' INT TERM

  echo "ushiCLI"
  echo "文字列を入力すると cowsay で返します。Ctrl+C または Ctrl+D で終了。"
  if [[ "$random_face" == true ]]; then
    echo "random-f: ON"
  fi
  if [[ -n "$selected_face" ]]; then
    echo "face: $selected_face"
  fi
  if [[ "$use_think" == true ]]; then
    echo "think: ON"
  fi
  if [[ "$use_lolcat" == true ]]; then
    echo "lolcat: ON"
  fi

  while true; do
    printf 'ushi> '
    if ! IFS= read -r line; then
      printf "\n終了しました。\n"
      break
    fi

    case "$line" in
      "") continue ;;
      exit|quit|:q)
        printf "終了しました。\n"
        break
        ;;
      *)
        run_cowsay "$line"
        ;;
    esac
  done
}

parse_short_flags() {
  local flags="$1"
  local i=0
  local flag=""
  local rest=""

  while ((i < ${#flags})); do
    flag="${flags:i:1}"
    case "$flag" in
      r)
        random_face=true
        ;;
      L)
        use_lolcat=true
        ;;
      l)
        list_faces=true
        ;;
      h)
        print_help
        exit 0
        ;;
      f)
        rest="${flags:i+1}"
        if [[ -n "$rest" ]]; then
          selected_face="$rest"
          return
        fi
        if ((${#args[@]} == 0)); then
          echo "Missing value for -f" >&2
          exit 1
        fi
        selected_face="${args[0]}"
        args=("${args[@]:1}")
        return
        ;;
      *)
        echo "Unknown option: -$flag" >&2
        exit 1
        ;;
    esac
    ((i += 1))
  done
}

main() {
  local args=("$@")
  local positional=()
  local arg=""

  require_cowsay
  while ((${#args[@]} > 0)); do
    arg="${args[0]}"
    args=("${args[@]:1}")
    case "$arg" in
      -r|--random-f)
        random_face=true
        ;;
      -f|--face)
        if ((${#args[@]} == 0)); then
          echo "Missing value for $arg" >&2
          exit 1
        fi
        selected_face="${args[0]}"
        args=("${args[@]:1}")
        ;;
      --face=*)
        selected_face="${arg#--face=}"
        ;;
      -l|--list-faces)
        list_faces=true
        ;;
      -L|--lolcat)
        use_lolcat=true
        ;;
      --think)
        use_think=true
        ;;
      --)
        positional+=("${args[@]}")
        args=()
        ;;
      -[!-]?*)
        parse_short_flags "${arg#-}"
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        positional+=("$arg")
        ;;
    esac
  done

  if [[ "$random_face" == true && -n "$selected_face" ]]; then
    echo "--random-f and --face cannot be used together" >&2
    exit 1
  fi

  require_cowthink
  require_lolcat

  if [[ "$list_faces" == true ]]; then
    list_available_faces
    exit 0
  fi

  if ((${#positional[@]} > 0)); then
    run_cowsay "${positional[*]}"
    exit 0
  fi

  if [[ -t 0 ]]; then
    run_repl
    exit 0
  fi

  local input
  input="$(cat)"
  input="${input%$'\n'}"
  if [[ -n "$input" ]]; then
    run_cowsay "$input"
  fi
}

main "$@"
