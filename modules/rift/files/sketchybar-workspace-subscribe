#!/bin/sh
set -eu

RIFT_CLI="${RIFT_CLI:-/opt/homebrew/bin/rift-cli}"
SKETCHYBAR_BIN="${SKETCHYBAR_BIN:-/opt/homebrew/bin/sketchybar}"
JQ="${JQ:-/usr/bin/jq}"
callback='exec "$1" --trigger workspace_change REFRESH=all'

subscription="$("$RIFT_CLI" subscribe list-cli 2>/dev/null || true)"
if printf '%s\n' "$subscription" | "$JQ" -e \
  --arg callback "$callback" --arg sketchybar "$SKETCHYBAR_BIN" \
  'any(.cli_subscriptions[]?;
    .event == "workspace_changed" and .command == "/bin/sh" and
    .args == ["-c", $callback, "sh", $sketchybar])' >/dev/null 2>&1; then
  exit 0
fi

"$RIFT_CLI" subscribe unsub-cli workspace_changed >/dev/null 2>&1 || true

exec "$RIFT_CLI" subscribe cli \
  --event workspace_changed \
  --command /bin/sh \
  --args -c \
  --args "$callback" \
  --args sh \
  --args "$SKETCHYBAR_BIN"
