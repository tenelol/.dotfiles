let
  lock = builtins.fromJSON (builtins.readFile ../../../flake.lock);
  source =
    name:
    let
      locked = lock.nodes.${lock.nodes.root.inputs.${name}}.locked;
    in
    (builtins.fetchTree {
      inherit (locked)
        type
        owner
        repo
        rev
        narHash
        ;
    }).outPath;
  pkgs = import (source "nixpkgs") {
    system = "aarch64-darwin";
    config.allowUnfree = true;
  };
  herdrPackage = pkgs.callPackage (source "herdr-bin" + "/package.nix") { };
  module = import ../default.nix {
    delib = {
      scopedModule = value: value;
      singleEnableOption = value: value;
    };
    hostTraits.darwinDesktop = true;
    inputs = {
      herdr = source "herdr";
      herdr-bin.packages.aarch64-darwin.default = herdrPackage;
    };
    inherit pkgs;
    inherit (pkgs) lib;
  };
  packages = module.home.ifEnabled.home.packages;
  summary = map (package: {
    pname = package.pname or package.name;
    version = package.version or null;
    inherit (package) drvPath;
    available = pkgs.lib.meta.availableOn pkgs.stdenv.hostPlatform package;
  }) packages;
  hasPackage = pname: version: builtins.any (package: (package.pname or "") == pname && (package.version or null) == version) packages;
in
assert builtins.all (package: package.available) summary;
assert hasPackage "gdrive" "3.9.1";
assert hasPackage "mysql" "9.7.1";
assert hasPackage "rift" "0.5.8.1";
assert hasPackage "peekaboo" "4.5.0";
assert hasPackage "zathura-with-plugins" "2026.05.20";
summary
