let
  lock = builtins.fromJSON (builtins.readFile ../../../flake.lock);
  source =
    name:
    let
      locked = lock.nodes.${lock.nodes.root.inputs.${name}}.locked;
    in
    (builtins.fetchTree {
      inherit (locked)
        type
        owner
        repo
        rev
        narHash
        ;
    }).outPath;
  pkgs = import (source "nixpkgs") {
    system = "aarch64-darwin";
    config.allowUnfree = true;
  };
  brewCask = pkgs.callPackage ../../../packages/brew-cask.nix { };
  casks = import (source "brew-nix" + "/casks.nix") {
    inherit pkgs;
    brew-api = source "brew-api";
  };
  apps = builtins.fromJSON (builtins.readFile ../files/apps.json);
  packages = pkgs.lib.listToAttrs (map (app: {
  name = app.name;
  value = brewCask (builtins.removeAttrs app [ "name" "selfUpdating" ] // { cask = casks.${app.name}; });
  }) (apps.base ++ apps.fullDesktop ++ apps.binaries ++ apps.fonts));
in packages // {
  runtimePackages = pkgs.lib.listToAttrs (map (app: {
    name = app.name;
    value = pkgs.callPackage ../../../packages/macos-app-support.nix { } app;
  }) (builtins.filter (app: app ? selfUpdating) (apps.base ++ apps.fullDesktop)));
  installerSources.microsoftAutoUpdate = casks.microsoft-auto-update.src;
} // pkgs.lib.listToAttrs (pkgs.lib.concatMap (name:
  pkgs.lib.optional (packages.${name} ? completionPackage) {
    name = "${name}-completions";
    value = packages.${name}.completionPackage;
  }
) (pkgs.lib.attrNames packages))
