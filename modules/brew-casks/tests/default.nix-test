let
  packages = import ./packages.nix-test;
  lock = builtins.fromJSON (builtins.readFile ../../../flake.lock);
  locked = lock.nodes.${lock.nodes.root.inputs.brew-api}.locked;
  api =
    (builtins.fetchTree {
      inherit (locked)
        type
        owner
        repo
        rev
        narHash
        ;
    }).outPath;
  data = builtins.fromJSON (builtins.readFile (api + "/cask.json"));
  apps = builtins.fromJSON (builtins.readFile ../files/apps.json);
  selected = map (app: app.name) (apps.base ++ apps.fullDesktop);
  metadata = builtins.map (
    name:
    let
      spec = builtins.head (builtins.filter (app: app.name == name) (apps.base ++ apps.fullDesktop));
      cask = builtins.head (builtins.filter (cask: cask.token == name) data);
      installArtifacts = builtins.filter (
        artifact: !(artifact ? zap || artifact ? uninstall)
      ) cask.artifacts;
      artifacts = builtins.filter (artifact: artifact ? app) cask.artifacts;
      package = packages.${name};
    in
    assert (spec ? sourceHash) || builtins.match "[0-9a-f]{64}" cask.sha256 != null;
    assert builtins.length artifacts == 1;
    assert builtins.all (artifact: !(artifact ? pkg || artifact ? installer || artifact ? font)) installArtifacts;
    assert package.sourceRoot == builtins.head (builtins.head artifacts).app;
    {
      inherit name;
      inherit (package) version drvPath sourceRoot;
      sourceHash = package.src.outputHash;
    } // (if package ? completionPackage then { completionDrvPath = package.completionPackage.drvPath; } else { })
  ) selected;
in
assert lock.nodes.brew-nix.inputs.brew-api == [ "brew-api" ];
assert lock.nodes.brew-nix.inputs.nixpkgs == [ "nixpkgs" ];
metadata
