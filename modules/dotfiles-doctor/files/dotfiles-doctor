#!/usr/bin/env bash
set -uo pipefail

run_eval=1
strict=0
ok_count=0
warn_count=0
fail_count=0

usage() {
  cat <<'EOF'
Usage: dotfiles doctor [--no-eval] [--strict]
       dotfiles-doctor [--no-eval] [--strict]

  --no-eval  Skip lightweight flake metadata/configuration evaluation
  --strict   Exit non-zero when warnings are present
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-eval)
      run_eval=0
      ;;
    --strict)
      strict=1
      ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  green=$'\033[32m'
  yellow=$'\033[33m'
  red=$'\033[31m'
  blue=$'\033[34m'
  reset=$'\033[0m'
else
  green=""
  yellow=""
  red=""
  blue=""
  reset=""
fi

section() {
  printf '\n%s\n' "$1"
}

status() {
  local level="$1"
  local label="$2"
  local detail="$3"
  local color marker

  case "$level" in
    ok)
      ok_count=$((ok_count + 1))
      color="$green"
      marker="ok"
      ;;
    warn)
      warn_count=$((warn_count + 1))
      color="$yellow"
      marker="warn"
      ;;
    fail)
      fail_count=$((fail_count + 1))
      color="$red"
      marker="fail"
      ;;
    info)
      color="$blue"
      marker="info"
      ;;
    *)
      color=""
      marker="$level"
      ;;
  esac

  printf '%b%-5s%b %-22s %s\n' "$color" "$marker" "$reset" "$label" "$detail"
}

has() {
  command -v "$1" >/dev/null 2>&1
}

line_count() {
  wc -l | tr -d '[:space:]'
}

stat_mtime() {
  if [ "$uname_s" = "Darwin" ]; then
    /usr/bin/stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$1" 2>/dev/null
  else
    stat -c '%y' "$1" 2>/dev/null | cut -d. -f1
  fi
}

repo_root="${DOTFILES_REPO:-$HOME/.dotfiles}"
uname_s="$(uname -s 2>/dev/null || printf unknown)"
rebuild_process_pattern='(^|[[:space:]/])(nh[[:space:]]+(os|darwin)[[:space:]]+(build|switch)|darwin-rebuild[[:space:]]+(build|switch)|nixos-rebuild[[:space:]]+(build|switch))([[:space:]]|$)'

check_system() {
  local host_name platform current_system

  section "System"

  host_name="$(hostname -s 2>/dev/null || hostname 2>/dev/null || printf unknown)"
  platform="$(uname -srm 2>/dev/null || uname -a 2>/dev/null || printf unknown)"
  status info "host" "$host_name"
  status info "platform" "$platform"

  if [ -e /run/current-system ]; then
    current_system="$(readlink /run/current-system 2>/dev/null || printf present)"
    status ok "current-system" "$current_system"
  else
    status warn "current-system" "/run/current-system is missing"
  fi
}

check_tools() {
  local tool path

  section "Tools"

  for tool in git nix nh; do
    if has "$tool"; then
      path="$(command -v "$tool")"
      status ok "$tool" "$path"
    else
      status fail "$tool" "not found in PATH"
    fi
  done

  if [ "$uname_s" = "Darwin" ]; then
    for tool in brew darwin-rebuild; do
      if has "$tool"; then
        status ok "$tool" "$(command -v "$tool")"
      else
        status warn "$tool" "not found in PATH"
      fi
    done
  elif [ "$uname_s" = "Linux" ]; then
    if has nixos-rebuild; then
      status ok "nixos-rebuild" "$(command -v nixos-rebuild)"
    else
      status warn "nixos-rebuild" "not found in PATH"
    fi
  fi
}

check_repo() {
  local branch commit dirty_count lock_mtime

  section "Repository"

  if [ ! -d "$repo_root" ]; then
    status fail "repo" "$repo_root does not exist"
    return
  fi
  status ok "repo" "$repo_root"

  if ! has git; then
    status fail "git status" "git is unavailable"
    return
  fi

  if git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    branch="$(git -C "$repo_root" branch --show-current 2>/dev/null || true)"
    commit="$(git -C "$repo_root" rev-parse --short HEAD 2>/dev/null || true)"
    if [ -n "$branch" ]; then
      status ok "git branch" "$branch @ ${commit:-unknown}"
    else
      status ok "git branch" "detached @ ${commit:-unknown}"
    fi

    dirty_count="$(git -C "$repo_root" status --porcelain=v1 2>/dev/null | line_count)"
    if [ "${dirty_count:-0}" = "0" ]; then
      status ok "git status" "clean"
    else
      status warn "git status" "$dirty_count changed or untracked paths"
    fi
  else
    status fail "git repo" "$repo_root is not a git worktree"
  fi

  if [ -f "$repo_root/flake.nix" ]; then
    status ok "flake.nix" "present"
  else
    status fail "flake.nix" "missing"
  fi

  if [ -f "$repo_root/flake.lock" ]; then
    lock_mtime="$(stat_mtime "$repo_root/flake.lock" || printf unknown)"
    status ok "flake.lock" "last changed $lock_mtime"
  else
    status warn "flake.lock" "missing"
  fi
}

check_flake() {
  local nixos_configs darwin_configs

  section "Flake"

  if [ "$run_eval" -eq 0 ]; then
    status info "eval" "skipped by --no-eval"
    return
  fi

  if [ ! -d "$repo_root" ] || [ ! -f "$repo_root/flake.nix" ]; then
    status fail "eval" "repo or flake.nix is missing"
    return
  fi

  if ! has nix; then
    status fail "eval" "nix is unavailable"
    return
  fi

  if nix flake metadata --no-write-lock-file "$repo_root" >/dev/null 2>&1; then
    status ok "metadata" "flake metadata evaluates"
  else
    status fail "metadata" "nix flake metadata failed"
  fi

  if nixos_configs="$(
    nix eval --raw "${repo_root}#nixosConfigurations" \
      --apply 'configs: builtins.concatStringsSep ", " (builtins.attrNames configs)' 2>/dev/null
  )"; then
    status ok "nixos configs" "${nixos_configs:-none}"
  else
    status fail "nixos configs" "evaluation failed"
  fi

  if darwin_configs="$(
    nix eval --raw "${repo_root}#darwinConfigurations" \
      --apply 'configs: builtins.concatStringsSep ", " (builtins.attrNames configs)' 2>/dev/null
  )"; then
    status ok "darwin configs" "${darwin_configs:-none}"
  else
    status fail "darwin configs" "evaluation failed"
  fi
}

check_rebuild_processes() {
  section "Rebuild"

  if has pgrep && pgrep -f "$rebuild_process_pattern" >/dev/null 2>&1; then
    status warn "rebuild process" "nh/darwin-rebuild/nixos-rebuild is already running"
  else
    status ok "rebuild process" "none detected"
  fi
}

check_darwin_desktop() {
  local target wallpaper wallpaper_target latest_log latest_log_mtime
  local raycast_script

  [ "$uname_s" = "Darwin" ] || return

  section "Darwin Desktop"

  if has pgrep && pgrep -qx AeroSpace >/dev/null 2>&1; then
    target="macbook-aerospace"
    status ok "window manager" "AeroSpace is running"
  elif has pgrep && { pgrep -qx rift >/dev/null 2>&1 || pgrep -qx Rift >/dev/null 2>&1; }; then
    target="macbook-rift"
    status ok "window manager" "Rift is running"
  elif [ -e "$HOME/.config/theme/wallpaper.png" ] \
    && [ "$(readlink "$HOME/.config/theme/wallpaper.png" 2>/dev/null | sed 's#.*/##')" = "wallpaper.png" ]; then
    target="macbook-mac"
    status ok "window manager" "native macOS rice"
  elif [ -e "$HOME/.config/aerospace/aerospace.toml" ]; then
    target="macbook-aerospace"
    status warn "window manager" "AeroSpace config exists, but process is not running"
  else
    target="macbook-rift"
    status warn "window manager" "Rift/AeroSpace process not detected"
  fi
  status info "switch target" "$target"

  wallpaper="$HOME/.config/theme/wallpaper.png"
  if [ -e "$wallpaper" ]; then
    wallpaper_target="$(readlink "$wallpaper" 2>/dev/null || printf present)"
    status ok "wallpaper" "$wallpaper_target"
  else
    status warn "wallpaper" "$wallpaper is missing"
  fi

  if has pgrep && pgrep -qx sketchybar >/dev/null 2>&1; then
    status ok "sketchybar" "running"
  elif [ -x /opt/homebrew/bin/sketchybar ]; then
    status warn "sketchybar" "installed but not running"
  else
    status warn "sketchybar" "not found"
  fi

  for raycast_script in dotfiles-rebuild-macbook.sh open-ghostty.sh; do
    if [ -x "$HOME/.config/raycast/scripts/$raycast_script" ]; then
      status ok "raycast script" "$raycast_script installed"
    else
      status warn "raycast script" "$raycast_script missing or not executable"
    fi
  done

  latest_log="$HOME/Library/Logs/dotfiles/macbook-switch-latest.log"
  if [ -e "$latest_log" ]; then
    latest_log_mtime="$(stat_mtime "$latest_log" || printf unknown)"
    status ok "switch log" "$latest_log, updated $latest_log_mtime"
  else
    status warn "switch log" "$latest_log is missing"
  fi
}

check_linux_desktop() {
  [ "$uname_s" = "Linux" ] || return

  section "Linux Desktop"

  status info "desktop" "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-unset}"
  status info "session" "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-unset}"

  if has pgrep && pgrep -x niri >/dev/null 2>&1; then
    status ok "niri" "running"
  else
    status info "niri" "process not detected"
  fi

  if [ -x "$HOME/.local/bin/apply-theme-wallpaper" ]; then
    status ok "wallpaper helper" "installed"
  else
    status info "wallpaper helper" "not installed"
  fi
}

check_system
check_tools
check_repo
check_flake
check_rebuild_processes
check_darwin_desktop
check_linux_desktop

section "Summary"

if [ "$fail_count" -gt 0 ]; then
  status fail "result" "$fail_count failure(s), $warn_count warning(s)"
  exit 1
fi

if [ "$warn_count" -gt 0 ]; then
  status warn "result" "$warn_count warning(s)"
  if [ "$strict" -eq 1 ]; then
    exit 1
  fi
  exit 0
fi

status ok "result" "$ok_count checks passed"
